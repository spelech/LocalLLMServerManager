{
  "name": "Text-to-3D Automated Pipeline (FLUX + TRELLIS V2)",
  "type": "3d",
  "description": "Automated End-to-End Pipeline: Text Prompt -> FLUX High-Detail Image -> TRELLIS V2 3D Mesh Output (.glb)",
  "workflow": {
    "1": {
      "inputs": {
        "text": "a futuristic cyberpunk sports car, 3d asset, studio lighting, clean white background",
        "clip": [ "2", 0 ]
      },
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "Text Prompt" }
    },
    "2": {
      "inputs": {
        "clip_name": "t5xxl_fp16.safetensors",
        "type": "flux2"
      },
      "class_type": "CLIPLoader",
      "_meta": { "title": "Load CLIP" }
    },
    "9": {
      "inputs": {
        "text": "",
        "clip": [ "2", 0 ]
      },
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "Negative Prompt" }
    },
    "3": {
      "inputs": {
        "seed": 42,
        "steps": 20,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": [ "4", 0 ],
        "positive": [ "1", 0 ],
        "negative": [ "9", 0 ],
        "latent_image": [ "5", 0 ]
      },
      "class_type": "KSampler",
      "_meta": { "title": "FLUX KSampler" }
    },
    "4": {
      "inputs": {
        "unet_name": "flux1-dev.safetensors",
        "weight_dtype": "fp8_e4m3fn"
      },
      "class_type": "UNETLoader",
      "_meta": { "title": "Load FLUX UNET" }
    },
    "5": {
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      },
      "class_type": "EmptyLatentImage",
      "_meta": { "title": "Empty Latent" }
    },
    "6": {
      "inputs": {
        "samples": [ "3", 0 ],
        "vae": [ "7", 0 ]
      },
      "class_type": "VAEDecode",
      "_meta": { "title": "VAE Decode Image" }
    },
    "7": {
      "inputs": {
        "vae_name": "ae.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": { "title": "Load VAE" }
    },
    "8": {
      "inputs": {
        "filename_prefix": "FLUX_TextTo3D_Anchor",
        "images": [ "6", 0 ]
      },
      "class_type": "SaveImage",
      "_meta": { "title": "Save Anchor Image" }
    },
    "10": {
      "inputs": {
        "modelname": "visualbruno/TRELLIS.2-4B-FP8",
        "backend": "sdpa",
        "device": "cuda",
        "low_vram": true,
        "keep_models_loaded": true,
        "conv_backend": "flex_gemm",
        "sparse_backend": "flash_attn",
        "use_reconviagen": false
      },
      "class_type": "Trellis2LoadModel",
      "_meta": { "title": "Load TRELLIS V2" }
    },
    "11": {
      "inputs": {
        "pipeline": [ "10", 0 ],
        "image": [ "6", 0 ],
        "seed": 42,
        "pipeline_type": "512",
        "sparse_structure_steps": 12,
        "shape_steps": 12,
        "texture_steps": 12,
        "max_num_tokens": 49152,
        "max_views": 4,
        "sparse_structure_resolution": 32,
        "generate_texture_slat": false,
        "use_tiled_decoder": true,
        "sampler": "euler",
        "fill_holes": false,
        "hole_iterations": 1,
        "hole_fill_algorithm": "flood_fill",
        "keep_only_shell": true
      },
      "class_type": "Trellis2MeshWithVoxelGenerator",
      "_meta": { "title": "TRELLIS Mesh Generator" }
    },
    "12": {
      "inputs": {
        "mesh": [ "11", 0 ],
        "reorient_vertices": "90 degrees"
      },
      "class_type": "Trellis2MeshWithVoxelToTrimesh",
      "_meta": { "title": "MeshWithVoxel to Trimesh" }
    },
    "13": {
      "inputs": {
        "trimesh": [ "12", 0 ],
        "filename_prefix": "Auto3D_CyberpunkCar",
        "file_format": "glb"
      },
      "class_type": "Trellis2ExportMesh",
      "_meta": { "title": "Export Watertight GLB" }
    }
  }
}
