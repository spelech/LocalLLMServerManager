{
  "name": "Die-Cut Sticker & Patch Generator",
  "type": "image",
  "description": "Clean, high-detail vector sticker generator with bold outlines and white die-cut borders using FLUX.1-dev",
  "workflow": {
    "1": {
      "inputs": {
        "text": "die-cut sticker of a cute baby panda wearing red headphones, bold thick black outlines, vibrant vector illustration, thick white die-cut border, isolated on clean white background, sticker style",
        "clip": [ "2", 0 ]
      },
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "Sticker Prompt" }
    },
    "2": {
      "inputs": {
        "clip_name": "t5xxl_fp16.safetensors",
        "type": "flux2"
      },
      "class_type": "CLIPLoader",
      "_meta": { "title": "Load CLIP" }
    },
    "9": {
      "inputs": {
        "text": "photo, realistic, complex background, shadow, blurry, low resolution, noise, watermark, signature",
        "clip": [ "2", 0 ]
      },
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "Negative Prompt" }
    },
    "3": {
      "inputs": {
        "seed": 123456,
        "steps": 24,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": [ "4", 0 ],
        "positive": [ "1", 0 ],
        "negative": [ "9", 0 ],
        "latent_image": [ "5", 0 ]
      },
      "class_type": "KSampler",
      "_meta": { "title": "KSampler" }
    },
    "4": {
      "inputs": {
        "unet_name": "flux1-dev.safetensors",
        "weight_dtype": "fp8_e4m3fn"
      },
      "class_type": "UNETLoader",
      "_meta": { "title": "Load FLUX UNET" }
    },
    "5": {
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      },
      "class_type": "EmptyLatentImage",
      "_meta": { "title": "Empty Latent" }
    },
    "6": {
      "inputs": {
        "samples": [ "3", 0 ],
        "vae": [ "7", 0 ]
      },
      "class_type": "VAEDecode",
      "_meta": { "title": "VAE Decode" }
    },
    "7": {
      "inputs": {
        "vae_name": "ae.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": { "title": "Load VAE" }
    },
    "8": {
      "inputs": {
        "filename_prefix": "Sticker_FLUX",
        "images": [ "6", 0 ]
      },
      "class_type": "SaveImage",
      "_meta": { "title": "Save Sticker Image" }
    }
  }
}
