<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Versioning convention: MAJOR.MINOR.PATCH
        MAJOR — breaking changes or major architecture rewrites
        MINOR — new user-facing features (bump per feature PR)
        PATCH — bug fixes, dependency updates, doc-only changes
    -->
    <Version>3.10.0</Version>
    <AssemblyVersion>3.10.0.0</AssemblyVersion>
    <FileVersion>3.10.0.0</FileVersion>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="LocalLLMServerManager.Shared\LocalLLMServerManager.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.0.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="LocalLLMServerManager.Shared/**" />
    <AvaloniaXaml Remove="LocalLLMServerManager.Shared/**" />
    <AvaloniaResource Remove="LocalLLMServerManager.Shared/**" />
    <Content Remove="LocalLLMServerManager.Shared/**" />
    <None Remove="LocalLLMServerManager.Shared/**" />
    <Compile Remove="LocalLLMServerManager.Web/**" />
    <AvaloniaXaml Remove="LocalLLMServerManager.Web/**" />
    <AvaloniaResource Remove="LocalLLMServerManager.Web/**" />
    <Content Remove="LocalLLMServerManager.Web/**" />
    <None Remove="LocalLLMServerManager.Web/**" />
    <Compile Remove="LocalLLMServerManager.Tests/**" />
    <EmbeddedResource Remove="LocalLLMServerManager.Tests/**" />
    <None Remove="LocalLLMServerManager.Tests/**" />
    <Content Remove="LocalLLMServerManager.Tests/**" />
    <Content Remove="wwwroot_wasm/**" />
    <None Remove="wwwroot_wasm/**" />
    <Content Remove="publish/**" />
    <Content Remove="dist/**" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Workflows/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
