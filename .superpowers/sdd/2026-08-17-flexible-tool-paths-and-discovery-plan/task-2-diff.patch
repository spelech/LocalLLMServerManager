++                }
++
++                if (foundRunner != null)
++                {
++                    var modelsDir = FindDirectory(dir, "models", "ComfyUI/models");
++                    var workflowsDir = FindDirectory(dir, "user/default/workflows", "ComfyUI/user/default/workflows", "workflows", "ComfyUI/workflows");
