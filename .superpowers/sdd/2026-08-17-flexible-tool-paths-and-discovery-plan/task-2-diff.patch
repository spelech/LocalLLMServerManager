++                {
++                    exePath = defaultPath;
++                }
++            }
++        }
++
++        if (string.IsNullOrEmpty(exePath))
++        {
++            return new DiscoveredToolInfo(
++                IsInstalled: false,
++                ExecutablePath: null,
++                RootDirectory: null,
++                ModelsDirectory: null,
++                WorkflowsDirectory: null,
++                StatusMessage: "Ollama not detected"
++            );
++        }
++
++        var rootDir = Path.GetDirectoryName(exePath);
