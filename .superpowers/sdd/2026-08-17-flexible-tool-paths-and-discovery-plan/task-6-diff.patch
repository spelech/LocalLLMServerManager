+function Get-AppSettings {
+    param([string]$Path)
+    
+    $candidates = @()
+    if ($Path) { $candidates += $Path }
+    $candidates += (Join-Path $PSScriptRoot "settings.json")
+    $candidates += (Join-Path $PSScriptRoot "..\settings.json")
+    if ($env:APPDATA) {
