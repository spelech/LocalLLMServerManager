+    [Fact]
+    public void PathChanges_UpdateStatusIndicatorsDynamically()
+    {
+        var vm = new SettingsViewModel();
+
+        // Initially missing
+        Assert.Contains("Missing", vm.ComfyUiExecutableStatus);
