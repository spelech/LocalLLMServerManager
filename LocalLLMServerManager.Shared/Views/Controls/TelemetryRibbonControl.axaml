<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="34"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.TelemetryRibbonControl"
             x:DataType="vm:TelemetryViewModel"
             Height="34">

    <UserControl.Styles>
        <Style Selector="Button.ribbon-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ribbon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
        </Style>
        <Style Selector="Button.ribbon-icon-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ribbon-icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Height="34"
            Background="{StaticResource BgSurfaceBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,0"
            ClipToBounds="True">
        <Grid ColumnDefinitions="*, Auto, Auto" VerticalAlignment="Center" ClipToBounds="True">
            <!-- Left: Engine Status Cards for Ollama, ComfyUI, SD Forge, Kokoro TTS -->
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- Ollama Card -->
                <Border Classes="matte-pill" Padding="6,2" ToolTip.Tip="{Binding OllamaCard.StatusTooltip}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{Binding OllamaCard.StatusColor}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OllamaCard.DisplayName}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OllamaCard.ActiveModel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding OllamaCard.HasActiveModel}" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                        <Button Classes="ribbon-btn"
                                Command="{Binding ToggleEngineCardCommand}"
                                CommandParameter="ollama"
                                Content="{Binding OllamaCard.ActionButtonText}"
                                FontSize="10"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ComfyUI Card -->
                <Border Classes="matte-pill" Padding="6,2" ToolTip.Tip="{Binding ComfyUiCard.StatusTooltip}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{Binding ComfyUiCard.StatusColor}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ComfyUiCard.DisplayName}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ComfyUiCard.ActiveModel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding ComfyUiCard.HasActiveModel}" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                        <Button Classes="ribbon-btn"
                                Command="{Binding ToggleEngineCardCommand}"
                                CommandParameter="comfyui"
                                Content="{Binding ComfyUiCard.ActionButtonText}"
                                FontSize="10"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- SD Forge Card -->
                <Border Classes="matte-pill" Padding="6,2" ToolTip.Tip="{Binding ForgeCard.StatusTooltip}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{Binding ForgeCard.StatusColor}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ForgeCard.DisplayName}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ForgeCard.ActiveModel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding ForgeCard.HasActiveModel}" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                        <Button Classes="ribbon-btn"
                                Command="{Binding ToggleEngineCardCommand}"
                                CommandParameter="forge"
                                Content="{Binding ForgeCard.ActionButtonText}"
                                FontSize="10"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Kokoro TTS Card -->
                <Border Classes="matte-pill" Padding="6,2" ToolTip.Tip="{Binding KokoroCard.StatusTooltip}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{Binding KokoroCard.StatusColor}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding KokoroCard.DisplayName}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding KokoroCard.ActiveModel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding KokoroCard.HasActiveModel}" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                        <Button Classes="ribbon-btn"
                                Command="{Binding ToggleEngineCardCommand}"
                                CommandParameter="kokoro"
                                Content="{Binding KokoroCard.ActionButtonText}"
                                FontSize="10"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <!-- Center: Unified Hardware Pill (GPU VRAM + Host RAM) -->
            <Border Grid.Column="1" Classes="matte-pill" Height="24" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" ToolTip.Tip="{Binding HardwareTooltipText}">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" ClipToBounds="True">
                    <PathIcon Data="{StaticResource IconGpu}" Width="12" Height="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding GpuName}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                               FontWeight="Medium" VerticalAlignment="Center" MaxWidth="110"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- VRAM Section -->
                    <TextBlock Text="VRAM" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <ProgressBar Value="{Binding VramPercentage}" Maximum="100" Classes="matte-progress"
                                 MinWidth="0" Width="34" Height="4" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding VramCompactText}" FontSize="10" Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="Bold" VerticalAlignment="Center"/>

                    <!-- Divider -->
                    <Border Width="1" Height="12" Background="{StaticResource GlassBorderBrush}" Margin="2,0" VerticalAlignment="Center"/>

                    <!-- RAM Section -->
                    <TextBlock Text="RAM" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <ProgressBar Value="{Binding RamPercentage}" Maximum="100" Classes="matte-progress"
                                 Foreground="{Binding RamBarColor}"
                                 MinWidth="0" Width="34" Height="4" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RamCompactText}" FontSize="10" Foreground="{Binding RamBarColor}"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Right: Refresh & Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="ribbon-icon-btn"
                        Command="{Binding PurgeMemoryCommand}"
                        ToolTip.Tip="Purge Idle Model &amp; Memory Caches">
                    <PathIcon Data="{StaticResource IconPurge}" Width="12" Height="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Classes="ribbon-icon-btn"
                        Command="{Binding RefreshStatusCommand}"
                        ToolTip.Tip="Refresh Service &amp; GPU Telemetry">
                    <PathIcon Data="{StaticResource IconRefresh}" Width="12" Height="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
