<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.DocumentationFloatingOverlay"
             x:DataType="vm:DocumentationViewModel"
             IsVisible="{Binding IsFloatingOverlayOpen}">

    <Panel>
        <!-- Minimized Floating Pill Mode -->
        <Border IsVisible="{Binding IsMinimizedToPill}"
                Background="#0F172A"
                BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="1.5"
                CornerRadius="20"
                Padding="12,6"
                BoxShadow="0 4 16 0 #80000000">
            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto" VerticalAlignment="Center">
                <!-- Drag Handle -->
                <TextBlock Grid.Column="0"
                           x:Name="PillDragHandle"
                           Text="⠿"
                           FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}"
                           Cursor="SizeAll"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <!-- Active Step Summary -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding SelectedSection.Icon}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentStep.StepNumber, StringFormat='Step {0}:'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentStep.Title}" FontSize="11" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Jump Button -->
                <Button Grid.Column="2"
                        Command="{Binding JumpToStepTabCommand}"
                        CommandParameter="{Binding CurrentStep.TargetTab}"
                        Classes="matte-pill"
                        Padding="6,2"
                        Margin="0,0,8,0"
                        ToolTip.Tip="Jump to the relevant tab for this step">
                    <TextBlock Text="🚀 Jump" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                </Button>

                <!-- Prev / Next Step -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="0,0,6,0">
                    <Button Command="{Binding PreviousStepCommand}" Classes="matte-pill" Padding="6,2">
                        <TextBlock Text="◀" FontSize="9"/>
                    </Button>
                    <Button Command="{Binding NextStepCommand}" Classes="matte-pill" Padding="6,2">
                        <TextBlock Text="▶" FontSize="9"/>
                    </Button>
                </StackPanel>

                <!-- Expand / Close -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                    <Button Command="{Binding ToggleMinimizeToPillCommand}" Classes="matte-pill" Padding="6,2" ToolTip.Tip="Expand Guide Window">
                        <TextBlock Text="🗖" FontSize="10"/>
                    </Button>
                    <Button Command="{Binding ToggleFloatingOverlayCommand}" Classes="matte-pill" Padding="6,2" ToolTip.Tip="Close Floating Guide">
                        <TextBlock Text="✕" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Full Floating Card Mode -->
        <Border IsVisible="{Binding !IsMinimizedToPill}"
                Width="380"
                Background="#0F172A"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                BoxShadow="0 8 24 0 #99000000">
            <Grid RowDefinitions="Auto, Auto, *, Auto">
                <!-- Draggable Header -->
                <Border Grid.Row="0"
                        x:Name="CardDragHandle"
                        Background="#1E293B"
                        CornerRadius="10,10,0,0"
                        Padding="12,8"
                        Cursor="SizeAll">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSection.Icon}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedSection.Title}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button Command="{Binding ToggleMinimizeToPillCommand}" Classes="matte-pill" Padding="6,2" ToolTip.Tip="Minimize to Floating Pill">
                                <TextBlock Text="—" FontSize="10"/>
                            </Button>
                            <Button Command="{Binding ToggleFloatingOverlayCommand}" Classes="matte-pill" Padding="6,2" ToolTip.Tip="Close Floating Guide">
                                <TextBlock Text="✕" FontSize="10"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section Summary & Step Counter Bar -->
                <Border Grid.Row="1" Background="#141E33" Padding="12,6" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="{Binding SelectedSection.Summary}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentStepIndex, StringFormat='Step {0} of {1}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Active Step Card -->
                <Border Grid.Row="2" Padding="14,12">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding CurrentStep.Title}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMainBrush}"/>
                            </StackPanel>

                            <!-- Smart Navigation Action Button -->
                            <Button Grid.Column="1"
                                    Command="{Binding JumpToStepTabCommand}"
                                    CommandParameter="{Binding CurrentStep.TargetTab}"
                                    Classes="matte-pill"
                                    Padding="8,4"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="🚀" FontSize="11"/>
                                    <TextBlock Text="Jump to Tab" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Action Instruction -->
                        <Border Background="#1E293B" CornerRadius="6" Padding="10,8" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1,0,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Action:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="{Binding CurrentStep.Action}" FontSize="12" Foreground="{StaticResource TextMainBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Expected Result -->
                        <Border Background="#1E293B" CornerRadius="6" Padding="10,8" BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="1,0,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Expected Result:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}"/>
                                <TextBlock Text="{Binding CurrentStep.ExpectedResult}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Navigation Controls Footer -->
                <Border Grid.Row="3" Background="#141E33" CornerRadius="0,0,10,10" Padding="12,8" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <Button Command="{Binding PreviousStepCommand}" Classes="matte-pill" Padding="10,4">
                                <TextBlock Text="◀ Previous" FontSize="11"/>
                            </Button>
                            <Button Command="{Binding NextStepCommand}" Classes="matte-pill" Padding="10,4">
                                <TextBlock Text="Next ▶" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="💡 Use while interacting with tabs" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Panel>
</UserControl>
