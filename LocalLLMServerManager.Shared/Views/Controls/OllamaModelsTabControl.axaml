<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.OllamaModelsTabControl"
             x:DataType="vm:OllamaLibraryViewModel">

    <Grid RowDefinitions="Auto, *, Auto" Margin="0,12,0,0">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
            <TextBlock Text="Ollama Local Model Library" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Command="{Binding UnloadAllVramCommand}" 
                    Classes="glass-secondary">
                🧹 Unload All VRAM
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding InstalledModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:OllamaModelItem">
                        <Border Classes="glass-card" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextMainBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <Border Classes="telemetry-pill">
                                            <TextBlock Text="{Binding CapabilityTag}" FontSize="11" Foreground="{Binding CapabilityColor}" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding FormatSize}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Installed 🟢" FontSize="12" Foreground="{StaticResource OnlineBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Classes="glass-card">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Interactive KV Cache Calculator" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding EstimatedKvCacheText}" FontSize="13" Foreground="{StaticResource SecondaryBrush}" FontWeight="Bold"/>
                </Grid>
                <Grid ColumnDefinitions="*, Auto">
                    <Slider Value="{Binding TargetContextTokens}" Minimum="1024" Maximum="32768" SmallChange="1024" LargeChange="4096"/>
                    <TextBlock Grid.Column="1" Text="{Binding TargetContextTokens, StringFormat='{}{0:N0} tokens'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
