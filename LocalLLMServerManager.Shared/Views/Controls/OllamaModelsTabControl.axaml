<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.OllamaModelsTabControl"
             x:DataType="vm:OllamaLibraryViewModel">

    <UserControl.Styles>
        <!-- Hardware Filter Buttons -->
        <Style Selector="Button.hw-filter-btn">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <Style Selector="Button.hw-filter-btn:pointerover">
            <Setter Property="Background" Value="#334155"/>
        </Style>
        <Style Selector="Button.hw-filter-btn.inactive">
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
        <Style Selector="Button.hw-filter-btn.inactive:pointerover">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Background" Value="#1E293B"/>
        </Style>

        <!-- Model Card Selectable Styles -->
        <Style Selector="Border.model-card">
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="Background" Value="#0B132B"/>
        </Style>
        <Style Selector="Border.model-card:pointerover">
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
        <Style Selector="Border.model-card.selected">
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Background" Value="#101D3A"/>
            <Setter Property="BoxShadow" Value="0 4 20 0 #333B82F6"/>
        </Style>

        <!-- Preset & Precision Chip Styles -->
        <Style Selector="Button.preset-chip">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.preset-chip:pointerover">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.preset-chip.chip-active">
            <Setter Property="Background" Value="#1E3A8A"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="Button.selected-btn">
            <Setter Property="Background" Value="#1E3A8A"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="0,12,0,0">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="🦙 Ollama Local Model Library" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Manage installed LLMs, calibrate KV cache, and launch models into Studio" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding UnloadAllVramCommand}" 
                    Classes="matte-secondary" VerticalAlignment="Center">
                🧹 Unload All VRAM
            </Button>
        </Grid>

        <!-- Hardware Compatibility Filter Chips -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Hardware Filter:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="FullVram" Classes="hw-filter-btn" Classes.inactive="{Binding !IsFullVramActive}" BorderBrush="#10B981">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="✓" IsVisible="{Binding IsFullVramActive}" Foreground="#10B981" FontWeight="Bold"/>
                        <TextBlock Text="✕" IsVisible="{Binding !IsFullVramActive}" Foreground="#64748B"/>
                        <TextBlock Text="🟢 Full VRAM" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="PartialOffload" Classes="hw-filter-btn" Classes.inactive="{Binding !IsPartialOffloadActive}" BorderBrush="#F59E0B">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="✓" IsVisible="{Binding IsPartialOffloadActive}" Foreground="#F59E0B" FontWeight="Bold"/>
                        <TextBlock Text="✕" IsVisible="{Binding !IsPartialOffloadActive}" Foreground="#64748B"/>
                        <TextBlock Text="🟡 Partial Offload" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="CpuOnly" Classes="hw-filter-btn" Classes.inactive="{Binding !IsCpuOnlyActive}" BorderBrush="#F97316">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="✓" IsVisible="{Binding IsCpuOnlyActive}" Foreground="#F97316" FontWeight="Bold"/>
                        <TextBlock Text="✕" IsVisible="{Binding !IsCpuOnlyActive}" Foreground="#64748B"/>
                        <TextBlock Text="🟠 CPU Only" FontSize="11" FontWeight="Bold" Foreground="#F97316"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="OutOfMemory" Classes="hw-filter-btn" Classes.inactive="{Binding !IsOomActive}" BorderBrush="#EF4444">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="✓" IsVisible="{Binding IsOomActive}" Foreground="#EF4444" FontWeight="Bold"/>
                        <TextBlock Text="✕" IsVisible="{Binding !IsOomActive}" Foreground="#64748B"/>
                        <TextBlock Text="🔴 Won't Fit" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Installed Models List with Active Selection -->
        <ScrollViewer Grid.Row="2" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding FilteredInstalledModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:OllamaModelItem">
                        <Border Classes="matte-card model-card"
                                Classes.selected="{Binding IsSelected}"
                                Margin="0,0,0,8"
                                Padding="14,12"
                                Cursor="Hand"
                                PointerPressed="OnModelCardPointerPressed">
                            <Grid ColumnDefinitions="*, Auto">
                                <!-- Model Identity Area -->
                                <StackPanel Grid.Column="0" Spacing="6" Background="Transparent">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextMainBrush}"/>
                                        <Border Classes="matte-pill" Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1"
                                                IsVisible="{Binding IsSelected}" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="● Selected for Sizing" FontSize="10" Foreground="#60A5FA" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="matte-pill">
                                            <TextBlock Text="GGUF" FontSize="11" Foreground="{StaticResource SecondaryBrush}" FontWeight="Bold"/>
                                        </Border>
                                        <Border Classes="matte-pill">
                                            <TextBlock Text="{Binding CapabilityTag}" FontSize="11" Foreground="{Binding CapabilityColor}" FontWeight="Bold"/>
                                        </Border>
                                        <Border Classes="matte-pill">
                                            <TextBlock Text="{Binding FormatSize}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Explicit Sizing Selector Button -->
                                    <Button Command="{Binding $parent[UserControl].((vm:OllamaLibraryViewModel)DataContext).SelectModelCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="matte-secondary"
                                            Classes.selected-btn="{Binding IsSelected}"
                                            ToolTip.Tip="Select this model for KV cache calculation and Studio inference"
                                            Padding="9,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="🧮 Select" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>

                                    <!-- Ambient Compatibility Pill with Click-to-Inspect -->
                                    <Button Command="{Binding $parent[UserControl].((vm:OllamaLibraryViewModel)DataContext).InspectModelCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#1E293B"
                                            BorderBrush="{Binding FitBadge.BadgeColorHex}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,4"
                                            ToolTip.Tip="{Binding FitBadge.Tooltip}"
                                            IsVisible="{Binding FitBadge, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Cursor="Hand"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding FitBadge.BadgeText}" FontSize="11" Foreground="{Binding FitBadge.BadgeColorHex}" FontWeight="Bold"/>
                                            <TextBlock Text="⚡ Check Fit" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Border Classes="matte-pill" VerticalAlignment="Center" Padding="10,4">
                                        <TextBlock Text="Installed 🟢" FontSize="11" Foreground="{StaticResource OnlineBrush}" FontWeight="Bold"/>
                                    </Border>

                                    <!-- Delete Model Button -->
                                    <Button Command="{Binding $parent[UserControl].((vm:OllamaLibraryViewModel)DataContext).RequestDeleteModelCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="matte-secondary"
                                            ToolTip.Tip="Delete model from local storage"
                                            Padding="8,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="🗑️" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Redesigned Functional KV Cache & VRAM Sizer Card -->
        <Border Grid.Row="3" Classes="matte-card" Padding="16,14" BorderBrush="#2563EB" BorderThickness="1.5" ClipToBounds="True">
            <StackPanel Spacing="12">
                <!-- Header: Sizer Title & Model Selected & Quick Modelfile Copy -->
                <Grid ColumnDefinitions="Auto, *, Auto" ClipToBounds="True">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="🧮 Interactive KV Cache &amp; VRAM Sizer" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                        <Border Classes="matte-pill" Background="#1E293B" Padding="8,3">
                            <TextBlock Text="{Binding CalcModelName}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ClipToBounds="True">
                        <Button Command="{Binding CopyModelfileParameterCommand}"
                                Classes="matte-secondary"
                                ToolTip.Tip="Copy 'PARAMETER num_ctx &lt;tokens&gt;' to clipboard for Ollama Modelfile"
                                Padding="8,4"
                                FontSize="11">
                            📋 Copy Modelfile num_ctx
                        </Button>
                        <Border Classes="matte-pill" Padding="8,3" Background="#1E293B" BorderBrush="{Binding CalcFitVerdictColor}" MaxWidth="420" ClipToBounds="True">
                            <TextBlock Text="{Binding CalcFitVerdictText}" FontSize="11" Foreground="{Binding CalcFitVerdictColor}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Slider and Quick Preset Pills -->
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                    <!-- Context Slider -->
                    <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,16,0">
                        <TextBlock Grid.Column="0" Text="Context:" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider Grid.Column="1" Value="{Binding TargetContextTokens}" Minimum="2048" Maximum="131072" SmallChange="2048" LargeChange="8192"/>
                        <Border Grid.Column="2" Classes="matte-pill" Margin="10,0,0,0" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TargetContextTokens, StringFormat='{}{0:N0} tokens'}" FontSize="12" Foreground="{StaticResource TextMainBrush}" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <!-- Precision & Preset Pills -->
                    <ScrollViewer Grid.Row="1" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ClipToBounds="True">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                            <TextBlock Text="Presets:" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="4K" Command="{Binding SetContextPresetCommand}" CommandParameter="4K" Classes="preset-chip"/>
                            <Button Content="8K" Command="{Binding SetContextPresetCommand}" CommandParameter="8K" Classes="preset-chip"/>
                            <Button Content="16K" Command="{Binding SetContextPresetCommand}" CommandParameter="16K" Classes="preset-chip"/>
                            <Button Content="32K" Command="{Binding SetContextPresetCommand}" CommandParameter="32K" Classes="preset-chip"/>
                            <Button Content="64K" Command="{Binding SetContextPresetCommand}" CommandParameter="64K" Classes="preset-chip"/>
                            <Button Content="128K" Command="{Binding SetContextPresetCommand}" CommandParameter="128K" Classes="preset-chip"/>

                            <Border Width="1" Height="14" Background="#334155" Margin="6,0"/>

                            <TextBlock Text="KV Precision:" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="FP16" Command="{Binding SetKvPrecisionCommand}" CommandParameter="FP16"
                                    Classes="preset-chip" Classes.chip-active="{Binding IsFp16Selected}"/>
                            <Button Content="Q8_0" Command="{Binding SetKvPrecisionCommand}" CommandParameter="Q8_0"
                                    Classes="preset-chip" Classes.chip-active="{Binding IsQ8Selected}"/>
                            <Button Content="Q4_0" Command="{Binding SetKvPrecisionCommand}" CommandParameter="Q4_0"
                                    Classes="preset-chip" Classes.chip-active="{Binding IsQ4Selected}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action: Use in Studio Button -->
                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                            Command="{Binding UseModelWithContextInStudioCommand}"
                            Background="#2563EB"
                            Foreground="White"
                            CornerRadius="8"
                            Padding="14,10"
                            VerticalAlignment="Center"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="🚀" FontSize="14" VerticalAlignment="Center"/>
                            <StackPanel Spacing="1">
                                <TextBlock Text="Use in Studio" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                <TextBlock Text="{Binding TargetContextTokens, StringFormat='num_ctx: {0:N0}'}" FontSize="10" Foreground="#BFDBFE"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Detailed VRAM Telemetry Bar & Live Memory Verdict -->
                <Border Background="#0B132B" CornerRadius="8" Padding="12,8" BorderBrush="#1E293B" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto" RowDefinitions="Auto, Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,0,16,0">
                            <TextBlock Text="Weights:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding CalcModelWeightText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,16,0">
                            <TextBlock Text="KV Cache:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding EstimatedKvCacheText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,16,0">
                            <TextBlock Text="Total Needed:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding CalcTotalVramNeededText}" FontSize="11" FontWeight="Bold" Foreground="{Binding CalcFitVerdictColor}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding CalcRecommendationMessage}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                                     Value="{Binding CalcVramUsageRatio}"
                                     Minimum="0" Maximum="1.0"
                                     Height="4" Margin="0,6,0,0"
                                     Foreground="{Binding CalcFitVerdictColor}"
                                     Background="#1E293B"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Styled Confirmation Modal Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#AA000000" IsVisible="{Binding IsDeleteModalOpen}" ZIndex="50">
            <Border Classes="matte-card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="🗑️" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DeleteModalTitle}" FontWeight="Bold" FontSize="14" Foreground="#EF4444" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CancelDeleteModelCommand}" Classes="matte-secondary" Padding="8,4"/>
                    </Grid>

                    <TextBlock Text="{Binding DeleteModalMessage}" FontSize="12" Foreground="{StaticResource TextMainBrush}" TextWrapping="Wrap" LineHeight="18"/>

                    <Grid ColumnDefinitions="*, *" Margin="0,6,0,0">
                        <Button Grid.Column="0" Command="{Binding CancelDeleteModelCommand}"
                                Content="Cancel" Classes="matte-secondary" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Margin="0,0,6,0" Padding="12,8"/>
                        <Button Grid.Column="1" Command="{Binding ConfirmDeleteModelCommand}"
                                IsEnabled="{Binding !IsDeleting}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Margin="6,0,0,0" Padding="12,8"
                                Background="#EF4444" Foreground="White" CornerRadius="6" FontWeight="Bold">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Delete Model" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
