<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.CivitaiTabControl"
             x:DataType="vm:CivitaiSearchViewModel">

    <Grid RowDefinitions="Auto, Auto, *" Margin="0,12,0,0">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0" Text="{Binding CivitaiSearchQuery}" PlaceholderText="Search Stable Diffusion checkpoints &amp; LoRAs..." 
                     Classes="matte-input" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Command="{Binding SearchCivitaiCommand}" 
                    Classes="matte-primary" Margin="8,0,0,0" VerticalAlignment="Center">
                🔍 Search CivitAI
            </Button>
        </Grid>

        <!-- Hardware Compatibility Filter Chips -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Hardware Filter:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="FullVram" Classes="matte-pill" Padding="6,2">
                    <TextBlock Text="🟢 Full VRAM" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                </Button>
                <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="PartialOffload" Classes="matte-pill" Padding="6,2">
                    <TextBlock Text="🟡 Partial Offload" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                </Button>
                <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="CpuOnly" Classes="matte-pill" Padding="6,2">
                    <TextBlock Text="🟠 CPU Only" FontSize="11" FontWeight="Bold" Foreground="#F97316"/>
                </Button>
                <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="OutOfMemory" Classes="matte-pill" Padding="6,2">
                    <TextBlock Text="🔴 Won't Fit" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding FilteredCivitaiResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:CivitaiModelItem">
                        <Border Classes="matte-card" Margin="0,0,0,8" Padding="14,12">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextMainBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                        <Border Classes="matte-pill" Padding="8,4">
                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                        </Border>
                                        <Border Classes="matte-pill" Padding="8,4">
                                            <TextBlock Text="{Binding DownloadCount, StringFormat='⬇️ {0:N0} downloads'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Ambient Compatibility Pill with Click-to-Inspect -->
                                    <Button Command="{Binding $parent[UserControl].((vm:CivitaiSearchViewModel)DataContext).InspectModelCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#1E293B"
                                            BorderBrush="{Binding FitBadge.BadgeColorHex}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,4"
                                            ToolTip.Tip="{Binding FitBadge.Tooltip}"
                                            IsVisible="{Binding FitBadge, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Cursor="Hand"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding FitBadge.BadgeText}" FontSize="11" Foreground="{Binding FitBadge.BadgeColorHex}" FontWeight="Bold"/>
                                            <TextBlock Text="⚡ Check Fit" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Content="⬇️ Download"
                                            Command="{Binding $parent[UserControl].((vm:CivitaiSearchViewModel)DataContext).DownloadCivitaiModelCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="matte-primary"
                                            Padding="10,4"
                                            FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
