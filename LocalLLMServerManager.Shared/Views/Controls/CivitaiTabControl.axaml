<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.CivitaiTabControl"
             x:DataType="vm:CivitaiSearchViewModel">

    <UserControl.Styles>
        <!-- Type Filter Buttons -->
        <Style Selector="Button.type-filter-btn">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.type-filter-btn:pointerover">
            <Setter Property="Background" Value="#334155"/>
        </Style>
        <Style Selector="Button.type-filter-btn.active">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#60A5FA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.type-filter-btn.active:pointerover">
            <Setter Property="Background" Value="#2563EB"/>
        </Style>

        <!-- Suggestion Chips -->
        <Style Selector="Button.suggestion-chip-btn">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.suggestion-chip-btn:pointerover">
            <Setter Property="Background" Value="#334155"/>
        </Style>

        <!-- Hardware Filter Buttons -->
        <Style Selector="Button.hw-filter-btn">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <Style Selector="Button.hw-filter-btn:pointerover">
            <Setter Property="Background" Value="#334155"/>
        </Style>
        <Style Selector="Button.hw-filter-btn.inactive">
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
        <Style Selector="Button.hw-filter-btn.inactive:pointerover">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Background" Value="#1E293B"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="0,12,0,0">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0" Text="{Binding CivitaiSearchQuery}" PlaceholderText="Search Stable Diffusion checkpoints &amp; LoRAs..." 
                     Classes="matte-input" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Command="{Binding SearchCivitaiCommand}" 
                    IsEnabled="{Binding !IsLoading}"
                    Classes="matte-primary" Margin="8,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🔍" IsVisible="{Binding !IsLoading}"/>
                    <TextBlock Text="⏳" IsVisible="{Binding IsLoading}"/>
                    <TextBlock Text="Search CivitAI" IsVisible="{Binding !IsLoading}"/>
                    <TextBlock Text="Searching..." IsVisible="{Binding IsLoading}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Search Loading Indicator -->
        <Border Grid.Row="1" IsVisible="{Binding IsLoading}" Background="#1E293B" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto, *">
                <TextBlock Grid.Column="0" Text="🔄 Querying CivitAI Hub API..." FontSize="12" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" IsIndeterminate="True" Height="4" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Filter Controls Card -->
        <Border Grid.Row="2" Classes="matte-card" Margin="0,0,0,10" Padding="12,10">
            <StackPanel Spacing="10">
                <!-- Row A: Model Type & Suggestions -->
                <Grid ColumnDefinitions="Auto, *">
                    <!-- Model Type Filter -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Model Type:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <Button Command="{Binding SelectCivitaiTypeCommand}" CommandParameter="All" Classes="type-filter-btn" Classes.active="{Binding IsTypeAllActive}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="✓" IsVisible="{Binding IsTypeAllActive}" FontWeight="Bold"/>
                                <TextBlock Text="All Types"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectCivitaiTypeCommand}" CommandParameter="Checkpoint" Classes="type-filter-btn" Classes.active="{Binding IsTypeCheckpointActive}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="✓" IsVisible="{Binding IsTypeCheckpointActive}" FontWeight="Bold"/>
                                <TextBlock Text="Checkpoints"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectCivitaiTypeCommand}" CommandParameter="LORA" Classes="type-filter-btn" Classes.active="{Binding IsTypeLoraActive}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="✓" IsVisible="{Binding IsTypeLoraActive}" FontWeight="Bold"/>
                                <TextBlock Text="LoRAs"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Suggestions Chips -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Suggestions:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <Button Content="🌟 SDXL" Command="{Binding ApplyStarterChipCommand}" CommandParameter="🌟 SDXL" Classes="suggestion-chip-btn"/>
                            <Button Content="📸 Photorealistic" Command="{Binding ApplyStarterChipCommand}" CommandParameter="📸 Photorealistic" Classes="suggestion-chip-btn"/>
                            <Button Content="🎨 Anime" Command="{Binding ApplyStarterChipCommand}" CommandParameter="🎨 Anime" Classes="suggestion-chip-btn"/>
                            <Button Content="🎭 Detail LoRA" Command="{Binding ApplyStarterChipCommand}" CommandParameter="🎭 Detail LoRA" Classes="suggestion-chip-btn"/>
                            <Button Content="⚡ Turbo" Command="{Binding ApplyStarterChipCommand}" CommandParameter="⚡ Turbo" Classes="suggestion-chip-btn"/>
                            <Button Content="🔮 Flux" Command="{Binding ApplyStarterChipCommand}" CommandParameter="🔮 Flux" Classes="suggestion-chip-btn"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Row B: Hardware Compatibility Filter Chips -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Hardware Filter:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="FullVram" Classes="hw-filter-btn" Classes.inactive="{Binding !IsFullVramActive}" BorderBrush="#10B981">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="✓" IsVisible="{Binding IsFullVramActive}" Foreground="#10B981" FontWeight="Bold"/>
                            <TextBlock Text="✕" IsVisible="{Binding !IsFullVramActive}" Foreground="#64748B"/>
                            <TextBlock Text="🟢 Full VRAM" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="PartialOffload" Classes="hw-filter-btn" Classes.inactive="{Binding !IsPartialOffloadActive}" BorderBrush="#F59E0B">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="✓" IsVisible="{Binding IsPartialOffloadActive}" Foreground="#F59E0B" FontWeight="Bold"/>
                            <TextBlock Text="✕" IsVisible="{Binding !IsPartialOffloadActive}" Foreground="#64748B"/>
                            <TextBlock Text="🟡 Partial Offload" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="CpuOnly" Classes="hw-filter-btn" Classes.inactive="{Binding !IsCpuOnlyActive}" BorderBrush="#F97316">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="✓" IsVisible="{Binding IsCpuOnlyActive}" Foreground="#F97316" FontWeight="Bold"/>
                            <TextBlock Text="✕" IsVisible="{Binding !IsCpuOnlyActive}" Foreground="#64748B"/>
                            <TextBlock Text="🟠 CPU Only" FontSize="11" FontWeight="Bold" Foreground="#F97316"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="OutOfMemory" Classes="hw-filter-btn" Classes.inactive="{Binding !IsOomActive}" BorderBrush="#EF4444">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="✓" IsVisible="{Binding IsOomActive}" Foreground="#EF4444" FontWeight="Bold"/>
                            <TextBlock Text="✕" IsVisible="{Binding !IsOomActive}" Foreground="#64748B"/>
                            <TextBlock Text="🔴 Won't Fit" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3">
            <StackPanel>
                <!-- Starter Recommendations when no search results loaded -->
                <StackPanel IsVisible="{Binding !FilteredCivitaiResults.Count}" Margin="0,0,0,16">
                    <Border Classes="matte-card" Padding="14,10" Margin="0,0,0,10" Background="#1A2234">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="💡 Featured Starters &amp; Popular Checkpoints to Explore" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Not sure where to begin? Start with these popular community checkpoints and LoRAs, or click a suggestion above:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding FilteredStarterModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:CivitaiModelItem">
                                <Border Classes="matte-card" Margin="0,0,0,8" Padding="14,12">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextMainBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                <Border Classes="matte-pill" Padding="8,4">
                                                    <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                                </Border>
                                                <Border Classes="matte-pill" Padding="8,4">
                                                    <TextBlock Text="{Binding DownloadCount, StringFormat='⬇️ {0:N0} downloads'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- Ambient Compatibility Pill with Click-to-Inspect -->
                                            <Button Command="{Binding $parent[UserControl].((vm:CivitaiSearchViewModel)DataContext).InspectModelCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="#1E293B"
                                                    BorderBrush="{Binding FitBadge.BadgeColorHex}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    ToolTip.Tip="{Binding FitBadge.Tooltip}"
                                                    IsVisible="{Binding FitBadge, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding FitBadge.BadgeText}" FontSize="11" Foreground="{Binding FitBadge.BadgeColorHex}" FontWeight="Bold"/>
                                                    <TextBlock Text="⚡ Check Fit" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Command="{Binding $parent[UserControl].((vm:CivitaiSearchViewModel)DataContext).OpenInBrowserCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="matte-secondary"
                                                    Padding="8,4"
                                                    FontSize="11"
                                                    ToolTip.Tip="View model page on CivitAI"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="🌐 View on Hub"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Content="⬇️ Download"
                                                    Command="{Binding $parent[UserControl].((vm:CivitaiSearchViewModel)DataContext).DownloadCivitaiModelCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="matte-primary"
                                                    Padding="10,4"
                                                    FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Filtered Active Results -->
                <ItemsControl ItemsSource="{Binding FilteredCivitaiResults}" IsVisible="{Binding FilteredCivitaiResults.Count}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:CivitaiModelItem">
                            <Border Classes="matte-card" Margin="0,0,0,8" Padding="14,12">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextMainBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                            <Border Classes="matte-pill" Padding="8,4">
                                                <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                            </Border>
                                            <Border Classes="matte-pill" Padding="8,4">
                                                <TextBlock Text="{Binding DownloadCount, StringFormat='⬇️ {0:N0} downloads'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- Ambient Compatibility Pill with Click-to-Inspect -->
                                        <Button Command="{Binding $parent[UserControl].((vm:CivitaiSearchViewModel)DataContext).InspectModelCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#1E293B"
                                                BorderBrush="{Binding FitBadge.BadgeColorHex}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                ToolTip.Tip="{Binding FitBadge.Tooltip}"
                                                IsVisible="{Binding FitBadge, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Cursor="Hand"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding FitBadge.BadgeText}" FontSize="11" Foreground="{Binding FitBadge.BadgeColorHex}" FontWeight="Bold"/>
                                                <TextBlock Text="⚡ Check Fit" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding $parent[UserControl].((vm:CivitaiSearchViewModel)DataContext).OpenInBrowserCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="matte-secondary"
                                                Padding="8,4"
                                                FontSize="11"
                                                ToolTip.Tip="View model page on CivitAI"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="🌐 View on Hub"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Content="⬇️ Download"
                                                Command="{Binding $parent[UserControl].((vm:CivitaiSearchViewModel)DataContext).DownloadCivitaiModelCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="matte-primary"
                                                Padding="10,4"
                                                FontSize="11"/>

                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
