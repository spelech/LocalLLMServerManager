<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.CivitaiTabControl"
             x:DataType="vm:CivitaiSearchViewModel">

    <Grid RowDefinitions="Auto, *" Margin="0,12,0,0">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
            <TextBox Text="{Binding CivitaiSearchQuery}" PlaceholderText="Search Stable Diffusion checkpoints &amp; LoRAs..." 
                     Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6" Padding="10,8"/>
            <Button Grid.Column="1" Command="{Binding SearchCivitaiCommand}" 
                    Background="#EC4899" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="6" Padding="16,8" Margin="8,0,0,0">
                🔍 Search CivitAI
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding CivitaiResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:CivitaiModelItem">
                        <Border Background="#1E293B" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <Border Background="#0F172A" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="#EC4899" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding DownloadCount, StringFormat='⬇️ {0:N0} downloads'}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
