<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             xmlns:models="using:LocalLLMServerManager.Shared.Models"
             xmlns:controls="using:LocalLLMServerManager.Shared.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="56" d:DesignHeight="800"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.ActivityRailControl"
             x:DataType="vm:NavigationRailViewModel"
             Background="{StaticResource BgSurfaceBrush}">

    <UserControl.Styles>
        <Style Selector="Button.rail-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.rail-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.rail-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
        </Style>
        <Style Selector="Button.rail-btn.active">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
        </Style>
        <Style Selector="Button.rail-btn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1A388BFD" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="0,8,0,8">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Top Primary Domain Buttons -->
            <StackPanel Grid.Row="0" Spacing="2">
                <!-- ⚡ Studio / Workflows -->
                <Button Classes="rail-btn"
                        Classes.active="{Binding IsStudioSelected}"
                        Command="{Binding SelectDomainCommand}"
                        CommandParameter="{x:Static models:NavDomain.Studio}"
                        ToolTip.Tip="⚡ Studio / Workflows">
                    <Grid ColumnDefinitions="44, *">
                        <Border Grid.Column="0" Width="3" Height="20" HorizontalAlignment="Left" CornerRadius="1.5"
                                Background="{StaticResource PrimaryBrush}"
                                IsVisible="{Binding IsStudioSelected}"/>
                        <TextBlock Grid.Column="0" Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Studio" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="2,0,4,0"
                                   IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=controls:ActivityRailControl}}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Button>

                <!-- 📦 Models & Hubs -->
                <Button Classes="rail-btn"
                        Classes.active="{Binding IsModelsSelected}"
                        Command="{Binding SelectDomainCommand}"
                        CommandParameter="{x:Static models:NavDomain.Models}"
                        ToolTip.Tip="📦 Models &amp; Hubs">
                    <Grid ColumnDefinitions="44, *">
                        <Border Grid.Column="0" Width="3" Height="20" HorizontalAlignment="Left" CornerRadius="1.5"
                                Background="{StaticResource PrimaryBrush}"
                                IsVisible="{Binding IsModelsSelected}"/>
                        <TextBlock Grid.Column="0" Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Models" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="2,0,4,0"
                                   IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=controls:ActivityRailControl}}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Button>

                <!-- 💻 Hardware Fit -->
                <Button Classes="rail-btn"
                        Classes.active="{Binding IsHardwareFitSelected}"
                        Command="{Binding SelectDomainCommand}"
                        CommandParameter="{x:Static models:NavDomain.HardwareFit}"
                        ToolTip.Tip="💻 Hardware Fit">
                    <Grid ColumnDefinitions="44, *">
                        <Border Grid.Column="0" Width="3" Height="20" HorizontalAlignment="Left" CornerRadius="1.5"
                                Background="{StaticResource PrimaryBrush}"
                                IsVisible="{Binding IsHardwareFitSelected}"/>
                        <TextBlock Grid.Column="0" Text="💻" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Fit" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="2,0,4,0"
                                   IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=controls:ActivityRailControl}}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Button>

                <!-- ⚙️ Settings & Daemon -->
                <Button Classes="rail-btn"
                        Classes.active="{Binding IsSettingsSelected}"
                        Command="{Binding SelectDomainCommand}"
                        CommandParameter="{x:Static models:NavDomain.Settings}"
                        ToolTip.Tip="⚙️ Settings &amp; Daemon">
                    <Grid ColumnDefinitions="44, *">
                        <Border Grid.Column="0" Width="3" Height="20" HorizontalAlignment="Left" CornerRadius="1.5"
                                Background="{StaticResource PrimaryBrush}"
                                IsVisible="{Binding IsSettingsSelected}"/>
                        <TextBlock Grid.Column="0" Text="⚙️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Settings" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="2,0,4,0"
                                   IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=controls:ActivityRailControl}}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Middle Empty Spacer (Row 1) -->

            <!-- Bottom Utilities & Expansion Toggle -->
            <StackPanel Grid.Row="2" Spacing="2">
                <!-- Subtle divider line -->
                <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}" Margin="6,4" />

                <!-- 📖 Documentation -->
                <Button x:Name="DocsBtn"
                        Classes="rail-btn"
                        Command="{Binding DocumentationCommand}"
                        ToolTip.Tip="📖 Documentation">
                    <Grid ColumnDefinitions="44, *">
                        <TextBlock Grid.Column="0" Text="📖" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Docs" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="2,0,4,0"
                                   IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=controls:ActivityRailControl}}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Button>

                <!-- 🤖 AI Assist -->
                <Button x:Name="AiAssistBtn"
                        Classes="rail-btn"
                        Command="{Binding AiAssistCommand}"
                        ToolTip.Tip="🤖 AI Assistant">
                    <Grid ColumnDefinitions="44, *">
                        <TextBlock Grid.Column="0" Text="🤖" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="AI Assist" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="2,0,4,0"
                                   IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=controls:ActivityRailControl}}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Button>

                <!-- ◀ / ▶ Expand/Collapse Toggle -->
                <Button x:Name="ToggleRailBtn"
                        Classes="rail-btn"
                        Command="{Binding ToggleRailExpandedCommand}"
                        ToolTip.Tip="Toggle Navigation Rail">
                    <Grid ColumnDefinitions="44, *">
                        <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="◀" FontSize="13"
                                       IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=controls:ActivityRailControl}}"/>
                            <TextBlock Text="▶" FontSize="13"
                                       IsVisible="{Binding !IsExpanded, RelativeSource={RelativeSource AncestorType=controls:ActivityRailControl}}"/>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="Collapse" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="2,0,4,0"
                                   IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=controls:ActivityRailControl}}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
