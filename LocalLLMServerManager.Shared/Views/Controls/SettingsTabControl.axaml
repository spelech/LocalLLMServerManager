<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.SettingsTabControl"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Margin="0,12,0,0">
        <StackPanel Spacing="16" Margin="0,0,0,16">
            <!-- Auto-Discovery Quick Action -->
            <Border Classes="matte-card" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="🔍 AI Ecosystem Auto-Discovery" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Automatically scan common install directories, drive roots, PATH, and AppData for Ollama, ComfyUI, and Stable Diffusion Forge:" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>

                    <Button Content="🔍 Auto-Detect Installed Tools" 
                            Command="{Binding AutoDetectToolsCommand}"
                            Classes="matte-primary" 
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Theme & Interface Mode Switcher -->
            <Border Classes="matte-card" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="🎨 Desktop Theme &amp; Web Interface Options" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Text="Select dynamic theme palette or switch framework theme styles:" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Theme Palette" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                        <ComboBox ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                  HorizontalAlignment="Left"
                                  MinWidth="240"/>
                    </StackPanel>

                    <TextBlock Text="Framework Theme Style:" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="✨ Semi Design Dark Theme" Command="{Binding SwitchThemeStyleCommand}" CommandParameter="semi"
                                Classes="matte-primary"/>
                        <Button Content="⚡ Fluent Dark Theme" Command="{Binding SwitchThemeStyleCommand}" CommandParameter="fluent"
                                Classes="matte-secondary"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Remote Access -->
            <Border Classes="matte-card" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="🌐 Remote &amp; Mobile Access URL" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Text="Connect to this manager from your smartphone, tablet, or laptop:" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                    <Border Classes="matte-pill" HorizontalAlignment="Left" Padding="10,6">
                        <SelectableTextBlock Text="{Binding LanAccessUrl}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Installed Components & Add-ons -->
            <Border Classes="matte-card" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="📦 Installed Components &amp; Add-ons" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="🔄 Refresh Status" Command="{Binding RefreshComponentStatusesCommand}" Classes="matte-secondary" Padding="10,4"/>
                    </Grid>
                    <TextBlock Text="Manage optional feature packs and inspect estimated disk usage:" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>

                    <!-- Video Pack Card -->
                    <Border Classes="matte-pill" Padding="12" Margin="0,4">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🎬 ComfyUI Video Generation Pack" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                                    <Border Classes="matte-pill" Padding="6,2">
                                        <TextBlock Text="{Binding VideoPackStatusText}" FontSize="11" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="DiT Wan 2.2, LTX-2.5 &amp; HunyuanVideo nodes | Estimated disk size: 14.2 GB" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Toggle / Uninstall" Command="{Binding ToggleVideoPackCommand}" Classes="matte-secondary" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Audio Pack Card -->
                    <Border Classes="matte-pill" Padding="12" Margin="0,4">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🔊 Kokoro TTS &amp; Audio Engine Pack" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                                    <Border Classes="matte-pill" Padding="6,2">
                                        <TextBlock Text="{Binding AudioPackStatusText}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="FastAPI text-to-speech engine &amp; models | Estimated disk size: 350 MB" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Toggle / Uninstall" Command="{Binding ToggleAudioPackCommand}" Classes="matte-secondary" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Paths and Settings -->
            <Border Classes="matte-card" Padding="16">
                <StackPanel Spacing="14">
                    <TextBlock Text="🛠️ Executable &amp; Directory Paths" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>

                    <!-- ComfyUI Executable -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="ComfyUI Executable Path" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                            <Border Classes="matte-pill" Padding="6,2">
                                <TextBlock Text="{Binding ComfyUiExecutableStatus}" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding ComfyUiExecutablePath, Mode=TwoWay}" Classes="matte-input"/>
                            <Button Grid.Column="1" Content="📁 Browse..." Command="{Binding BrowseComfyExecutableCommand}" Margin="8,0,0,0" Classes="matte-secondary"/>
                        </Grid>
                    </StackPanel>

                    <!-- Forge Executable -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Forge Executable Path" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                            <Border Classes="matte-pill" Padding="6,2">
                                <TextBlock Text="{Binding ForgeExecutableStatus}" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding ForgeExecutablePath, Mode=TwoWay}" Classes="matte-input"/>
                            <Button Grid.Column="1" Content="📁 Browse..." Command="{Binding BrowseForgeExecutableCommand}" Margin="8,0,0,0" Classes="matte-secondary"/>
                        </Grid>
                    </StackPanel>

                    <!-- Ollama Executable -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Ollama Executable Path" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                            <Border Classes="matte-pill" Padding="6,2">
                                <TextBlock Text="{Binding OllamaStatus}" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding OllamaExecutablePath, Mode=TwoWay}" Classes="matte-input"/>
                            <Button Grid.Column="1" Content="📁 Browse..." Command="{Binding BrowseOllamaExecutableCommand}" Margin="8,0,0,0" Classes="matte-secondary"/>
                        </Grid>
                    </StackPanel>

                    <!-- Forge Models -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Forge Models Directory Path" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                            <Border Classes="matte-pill" Padding="6,2">
                                <TextBlock Text="{Binding ForgeModelsStatus}" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding ForgeModelsPath, Mode=TwoWay}" Classes="matte-input"/>
                            <Button Grid.Column="1" Content="📁 Browse..." Command="{Binding BrowseForgeModelsCommand}" Margin="8,0,0,0" Classes="matte-secondary"/>
                        </Grid>
                    </StackPanel>

                    <!-- ComfyUI Models -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="ComfyUI Models Directory Path" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                            <Border Classes="matte-pill" Padding="6,2">
                                <TextBlock Text="{Binding ComfyModelsStatus}" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding ComfyModelsPath, Mode=TwoWay}" Classes="matte-input"/>
                            <Button Grid.Column="1" Content="📁 Browse..." Command="{Binding BrowseComfyModelsCommand}" Margin="8,0,0,0" Classes="matte-secondary"/>
                        </Grid>
                    </StackPanel>

                    <!-- 3D Models Output -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="3D Models Output Path" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                            <Border Classes="matte-pill" Padding="6,2">
                                <TextBlock Text="{Binding ThreeDModelsStatus}" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding ThreeDModelsPath, Mode=TwoWay}" Classes="matte-input"/>
                            <Button Grid.Column="1" Content="📁 Browse..." Command="{Binding BrowseThreeDModelsCommand}" Margin="8,0,0,0" Classes="matte-secondary"/>
                        </Grid>
                    </StackPanel>

                    <!-- Workflows Directory -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Workflows Directory Path" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                            <Border Classes="matte-pill" Padding="6,2">
                                <TextBlock Text="{Binding WorkflowsStatus}" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding WorkflowsPath, Mode=TwoWay}" Classes="matte-input"/>
                            <Button Grid.Column="1" Content="📁 Browse..." Command="{Binding BrowseWorkflowsCommand}" Margin="8,0,0,0" Classes="matte-secondary"/>
                        </Grid>
                    </StackPanel>

                    <!-- ComfyUI URL -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="ComfyUI URL" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                        <TextBox Text="{Binding ComfyUiUrl, Mode=TwoWay}" Classes="matte-input"/>
                    </StackPanel>

                    <!-- Preferred Image Engine -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Preferred Image Engine" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                        <TextBox Text="{Binding PreferredImageEngine, Mode=TwoWay}" Classes="matte-input"/>
                    </StackPanel>

                    <Button Command="{Binding SaveSettingsCommand}" 
                            Classes="matte-primary" HorizontalAlignment="Left" Margin="0,8,0,0">
                        💾 Save Settings
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
