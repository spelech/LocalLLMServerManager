<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.SettingsTabControl"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Margin="0,12,0,0">
        <StackPanel Spacing="16">
            <!-- Theme & Interface Mode Switcher -->
            <Border Classes="glass-card">
                <StackPanel Spacing="12">
                    <TextBlock Text="🎨 Desktop Theme &amp; Web Interface Options" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Text="Try switching between desktop themes or launch the browser dashboard:" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="✨ Semi Design Dark Theme" Command="{Binding SwitchThemeStyleCommand}" CommandParameter="semi"
                                Classes="glass-primary"/>
                        <Button Content="⚡ Fluent Dark Theme" Command="{Binding SwitchThemeStyleCommand}" CommandParameter="fluent"
                                Classes="glass-secondary"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Remote Access -->
            <Border Classes="glass-card">
                <StackPanel Spacing="10">
                    <TextBlock Text="🌐 Remote &amp; Mobile Access URL" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Text="Connect to this manager from your smartphone, tablet, or laptop:" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                    <Border Classes="telemetry-pill" HorizontalAlignment="Left">
                        <SelectableTextBlock Text="{Binding LanAccessUrl}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Paths and Settings -->
            <Border Classes="glass-card">
                <StackPanel Spacing="12">
                    <TextBlock Text="🛠️ Executable &amp; Directory Paths" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="ComfyUI Executable Path" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                        <TextBox Text="{Binding ComfyUiExecutablePath, Mode=TwoWay}" Classes="glass-input"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Forge Executable Path" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                        <TextBox Text="{Binding ForgeExecutablePath, Mode=TwoWay}" Classes="glass-input"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Forge Models Directory Path" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                        <TextBox Text="{Binding ForgeModelsPath, Mode=TwoWay}" Classes="glass-input"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="3D Models Output Path" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                        <TextBox Text="{Binding ThreeDModelsPath, Mode=TwoWay}" Classes="glass-input"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Workflows Directory Path" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                        <TextBox Text="{Binding WorkflowsPath, Mode=TwoWay}" Classes="glass-input"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="ComfyUI URL" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                        <TextBox Text="{Binding ComfyUiUrl, Mode=TwoWay}" Classes="glass-input"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Preferred Image Engine" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                        <TextBox Text="{Binding PreferredImageEngine, Mode=TwoWay}" Classes="glass-input"/>
                    </StackPanel>

                    <Button Command="{Binding SaveSettingsCommand}" 
                            Classes="glass-primary" HorizontalAlignment="Left" Margin="0,8,0,0">
                        💾 Save Settings
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
