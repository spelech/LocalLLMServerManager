<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.TelemetryHeaderControl"
             x:DataType="vm:TelemetryViewModel">

    <Grid>
        <!-- Full 3-Card Telemetry Dashboard (when !IsCollapsed) -->
        <Grid ColumnDefinitions="1.2*, 1.1*, *" Margin="16,14,16,10" IsVisible="{Binding !IsCollapsed}">
            <!-- CARD 1: Service Health Badges / Interactive Engine Status Cards -->
            <Border Grid.Column="0" Classes="matte-card" Margin="0,0,8,0" Padding="12,10">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="⚡ Engine Health Status" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <Border Grid.Column="1" Classes="matte-pill" Padding="6,2">
                            <TextBlock Text="Services" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    <UniformGrid Columns="4">
                        <!-- Ollama Card -->
                        <Border Classes="matte-pill" Margin="2,0" Padding="6,4" ToolTip.Tip="{Binding OllamaCard.StatusTooltip}">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{Binding OllamaCard.StatusColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding OllamaCard.DisplayName}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding OllamaCard.DisplaySubtitle}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" MaxWidth="75" TextTrimming="CharacterEllipsis"/>
                                <Button Classes="matte-secondary" Padding="6,2" Height="20"
                                        Command="{Binding ToggleEngineCardCommand}" CommandParameter="ollama"
                                        Content="{Binding OllamaCard.ActionButtonText}" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- SD Forge Card -->
                        <Border Classes="matte-pill" Margin="2,0" Padding="6,4" ToolTip.Tip="{Binding ForgeCard.StatusTooltip}">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{Binding ForgeCard.StatusColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ForgeCard.DisplayName}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ForgeCard.DisplaySubtitle}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" MaxWidth="75" TextTrimming="CharacterEllipsis"/>
                                <Button Classes="matte-secondary" Padding="6,2" Height="20"
                                        Command="{Binding ToggleEngineCardCommand}" CommandParameter="forge"
                                        Content="{Binding ForgeCard.ActionButtonText}" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- ComfyUI Card -->
                        <Border Classes="matte-pill" Margin="2,0" Padding="6,4" ToolTip.Tip="{Binding ComfyUiCard.StatusTooltip}">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{Binding ComfyUiCard.StatusColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ComfyUiCard.DisplayName}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ComfyUiCard.DisplaySubtitle}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" MaxWidth="75" TextTrimming="CharacterEllipsis"/>
                                <Button Classes="matte-secondary" Padding="6,2" Height="20"
                                        Command="{Binding ToggleEngineCardCommand}" CommandParameter="comfyui"
                                        Content="{Binding ComfyUiCard.ActionButtonText}" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Kokoro TTS Card -->
                        <Border Classes="matte-pill" Margin="2,0" Padding="6,4" ToolTip.Tip="{Binding KokoroCard.StatusTooltip}">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{Binding KokoroCard.StatusColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding KokoroCard.DisplayName}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding KokoroCard.DisplaySubtitle}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" MaxWidth="75" TextTrimming="CharacterEllipsis"/>
                                <Button Classes="matte-secondary" Padding="6,2" Height="20"
                                        Command="{Binding ToggleEngineCardCommand}" CommandParameter="kokoro"
                                        Content="{Binding KokoroCard.ActionButtonText}" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- CARD 2: GPU VRAM Memory Telemetry Chip -->
            <Border Grid.Column="1" Classes="matte-card" Margin="4,0,4,0" Padding="14,10">
                <StackPanel Spacing="6" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="🎮 VRAM Allocation" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding GpuName}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="Medium"/>
                        </StackPanel>
                        <Border Grid.Column="1" Classes="matte-pill" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VramStatusText}" FontSize="11" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                    <ProgressBar Value="{Binding VramPercentage}" Maximum="100" Classes="matte-progress" Height="8" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- CARD 3: Reverse Proxy & Quick Actions -->
            <Border Grid.Column="2" Classes="matte-card" Margin="8,0,0,0" Padding="14,10">
                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="🌐 Orchestrator Proxy" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <Border Classes="matte-pill" HorizontalAlignment="Left" Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ServiceModeText}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshStatusCommand}" Classes="matte-secondary" VerticalAlignment="Center" Padding="10,6">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="🔄" FontSize="11"/>
                                <TextBlock Text="Refresh" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleCollapseCommand}" Classes="matte-secondary" VerticalAlignment="Center" Padding="10,6" ToolTip.Tip="Collapse Telemetry Header">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="▲" FontSize="11"/>
                                <TextBlock Text="Collapse" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Slim 32px Horizontal Status Ribbon (when IsCollapsed) -->
        <Border Classes="matte-card" Height="32" Margin="16,6,16,6" Padding="12,0" IsVisible="{Binding IsCollapsed}">
            <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                <!-- Left: Service indicator dots for Ollama, Forge SD, ComfyUI, Kokoro TTS -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Classes="matte-pill" Padding="6,2" ToolTip.Tip="{Binding OllamaCard.StatusTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{Binding OllamaCard.StatusColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OllamaCard.DisplayName}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Classes="matte-secondary" Padding="4,1" Height="18"
                                    Command="{Binding ToggleEngineCardCommand}" CommandParameter="ollama"
                                    Content="{Binding OllamaCard.ActionButtonText}" FontSize="9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="matte-pill" Padding="6,2" ToolTip.Tip="{Binding ForgeCard.StatusTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{Binding ForgeCard.StatusColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ForgeCard.DisplayName}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Classes="matte-secondary" Padding="4,1" Height="18"
                                    Command="{Binding ToggleEngineCardCommand}" CommandParameter="forge"
                                    Content="{Binding ForgeCard.ActionButtonText}" FontSize="9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="matte-pill" Padding="6,2" ToolTip.Tip="{Binding ComfyUiCard.StatusTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{Binding ComfyUiCard.StatusColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ComfyUiCard.DisplayName}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Classes="matte-secondary" Padding="4,1" Height="18"
                                    Command="{Binding ToggleEngineCardCommand}" CommandParameter="comfyui"
                                    Content="{Binding ComfyUiCard.ActionButtonText}" FontSize="9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="matte-pill" Padding="6,2" ToolTip.Tip="{Binding KokoroCard.StatusTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{Binding KokoroCard.StatusColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding KokoroCard.DisplayName}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Classes="matte-secondary" Padding="4,1" Height="18"
                                    Command="{Binding ToggleEngineCardCommand}" CommandParameter="kokoro"
                                    Content="{Binding KokoroCard.ActionButtonText}" FontSize="9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: Compact VRAM allocation pill (VramStatusText) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <Border Classes="matte-pill" Padding="8,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="🎮" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding VramStatusText}" FontSize="11" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Button ▼ Expand binding to ToggleCollapseCommand -->
                <Button Grid.Column="2" Command="{Binding ToggleCollapseCommand}" Classes="matte-secondary" VerticalAlignment="Center" Padding="8,3" ToolTip.Tip="Expand Telemetry Header">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="▼" FontSize="10"/>
                        <TextBlock Text="Expand" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Manage Service Modal -->
        <Border Background="#CC000000" IsVisible="{Binding IsManageServiceModalOpen}" ZIndex="100">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="Manage Service" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ManageServicePrompt}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Command="{Binding CancelManageServiceCommand}" Classes="matte-secondary" Padding="16,8"/>
                        <Button Content="Confirm" Command="{Binding ConfirmManageServiceCommand}" Classes="matte-primary" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
