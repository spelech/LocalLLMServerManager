<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.TelemetryHeaderControl"
             x:DataType="vm:TelemetryViewModel">

    <Border Classes="glass-card" Margin="16,16,16,8">
        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="Local LLM Server Manager" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <Border Classes="telemetry-pill">
                        <TextBlock Text="{Binding GpuName}" FontSize="12" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <Border Classes="telemetry-pill">
                        <TextBlock Text="{Binding ServiceModeText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <Button Grid.Row="0" Grid.Column="1" Command="{Binding RefreshStatusCommand}" 
                    Classes="glass-secondary" VerticalAlignment="Top">
                🔄 Refresh Telemetry
            </Button>

            <!-- VRAM Allocation Gauge Bar -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" RowDefinitions="Auto, Auto" Margin="0,12,0,0">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                    <TextBlock Text="GPU VRAM Allocation" FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                    <TextBlock Grid.Column="1" Text="{Binding VramStatusText}" FontSize="12" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/>
                </Grid>
                <ProgressBar Grid.Row="1" Value="{Binding VramPercentage}" Maximum="100" Classes="glass-progress"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
