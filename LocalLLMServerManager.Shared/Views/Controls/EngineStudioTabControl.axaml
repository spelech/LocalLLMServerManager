<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.EngineStudioTabControl"
             x:DataType="vm:MainViewModel">

    <StackPanel Spacing="12" Margin="0,12,0,0">
        <TextBlock Text="AI Image &amp; 3D Generation Engines" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>

        <UniformGrid Columns="2">
            <Border Classes="glass-card" Margin="0,0,6,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="🎨 Stable Diffusion / Forge" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Text="{Binding ForgeStatus, StringFormat='Status: {0}'}" FontSize="13" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="Port 7860 • WebUI &amp; SD API Endpoint" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <Button Content="▶️ Start Forge Engine" Command="{Binding ToggleEngineCommand}" CommandParameter="forge" 
                            Classes="glass-primary" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Classes="glass-card" Margin="6,0,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="🧩 ComfyUI 3D Mesh Studio" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Text="{Binding ComfyStatus, StringFormat='Status: {0}'}" FontSize="13" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="Port 8188 • TRELLIS V2 &amp; Hunyuan3D Pipelines" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <Button Content="▶️ Start ComfyUI Engine" Command="{Binding ToggleEngineCommand}" CommandParameter="comfy" 
                            Classes="glass-primary" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </StackPanel>
</UserControl>
