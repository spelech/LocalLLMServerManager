<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             xmlns:controls="using:LocalLLMServerManager.Shared.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="950"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.EngineStudioTabControl"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- Modality Pill Buttons -->
        <Style Selector="Button.modality-pill">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.modality-pill /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style Selector="Button.modality-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#388BFD" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.modality-pill.active">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.modality-pill.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#60A5FA" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Prompt Starter Suggestion Chips -->
        <Style Selector="Button.starter-chip">
            <Setter Property="Background" Value="#111827" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1F2937" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.starter-chip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.starter-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#388BFD" />
            <Setter Property="Foreground" Value="#38BDF8" />
        </Style>

        <!-- Model Flyout Item Button -->
        <Style Selector="Button.model-item-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.model-item-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.model-item-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Model Badge Pill Button -->
        <Style Selector="Button.model-badge-btn">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.model-badge-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.model-badge-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#388BFD" />
        </Style>

        <!-- Aspect Ratio Option Pill -->
        <Style Selector="Button.aspect-pill">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Button.aspect-pill /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.aspect-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#388BFD" />
        </Style>
        <Style Selector="Button.aspect-pill.active">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.aspect-pill.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#60A5FA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="0,8,0,0">

        <!-- ======================================================== -->
        <!-- ROW 0: Feature Pack Optional Install Banners             -->
        <!-- ======================================================== -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
            <controls:FeaturePackBannerControl x:Name="VideoFeatureBanner"
                                               Title="ComfyUI Video Generation Pack Available"
                                               Description="Enables Wan 2.2, LTX-2.5, and HunyuanVideo DiT workflows."
                                               DiskSize="14.2 GB"
                                               MinVram="8 GB"
                                               InstallCommand="{Binding Settings.ToggleVideoPackCommand}"
                                               IsVisible="{Binding !Settings.IsVideoPackInstalled}"/>
            <controls:FeaturePackBannerControl x:Name="AudioFeatureBanner"
                                               Title="Kokoro TTS &amp; Audio Engine Pack Available"
                                               Description="Enables fast local text-to-speech with OpenAI /v1/audio/speech compatibility."
                                               DiskSize="350 MB"
                                               MinVram="CPU / 2 GB"
                                               InstallCommand="{Binding Settings.ToggleAudioPackCommand}"
                                               IsVisible="{Binding !Settings.IsAudioPackInstalled}"/>
        </StackPanel>

        <!-- ======================================================== -->
        <!-- ROW 1: TOP MODALITY SELECTOR BAR                         -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" Background="#0A0F1D" BorderBrush="#1E2B3E" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12" BoxShadow="0 4 16 0 #30000000">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- Modality Pill Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Image Modality Pill -->
                    <Button Classes="modality-pill"
                            Classes.active="{Binding IsImageModalityActive}"
                            Command="{Binding SelectModalityCommand}"
                            CommandParameter="Image"
                            ToolTip.Tip="Image Studio: Stable Diffusion &amp; WebUI Forge">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🎨" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Image" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Text Modality Pill -->
                    <Button Classes="modality-pill"
                            Classes.active="{Binding IsTextModalityActive}"
                            Command="{Binding SelectModalityCommand}"
                            CommandParameter="Text"
                            ToolTip.Tip="Text Reasoning: Ollama Local LLMs">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="💬" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Text" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Video Modality Pill -->
                    <Button Classes="modality-pill"
                            Classes.active="{Binding IsVideoModalityActive}"
                            Command="{Binding SelectModalityCommand}"
                            CommandParameter="Video"
                            ToolTip.Tip="Video Generation: ComfyUI, Wan 2.2 &amp; LTX-2.5">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🎬" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Video" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 3D Mesh Modality Pill -->
                    <Button Classes="modality-pill"
                            Classes.active="{Binding Is3DModalityActive}"
                            Command="{Binding SelectModalityCommand}"
                            CommandParameter="3D Mesh"
                            ToolTip.Tip="3D Synthesis: TRELLIS V2 &amp; Hunyuan3D">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🧊" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="3D Mesh" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Audio Modality Pill -->
                    <Button Classes="modality-pill"
                            Classes.active="{Binding IsAudioModalityActive}"
                            Command="{Binding SelectModalityCommand}"
                            CommandParameter="Audio"
                            ToolTip.Tip="Audio Synthesis: Kokoro Speech &amp; AudioCraft">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🎙️" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Audio" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Sticker Studio Modality Pill -->
                    <Button Classes="modality-pill"
                            Classes.active="{Binding IsStickerModalityActive}"
                            Command="{Binding SelectModalityCommand}"
                            CommandParameter="Sticker Studio"
                            ToolTip.Tip="Sticker Studio: Reference image to die-cut vinyl sticker generation">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🏷️" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Stickers" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Context Badges & Diagnostic Action -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Dynamic Active Model Badge -->
                    <Button Classes="model-badge-btn" ToolTip.Tip="Click to switch model / workflow">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <Border Background="#0D1322" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MinWidth="260" MaxWidth="340">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*, Auto" Margin="4,2">
                                            <TextBlock Text="Select Active Model" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="🔄 Scan" Command="{Binding RefreshScannedModelsCommand}" Classes="matte-secondary" Padding="6,2" FontSize="10"/>
                                        </Grid>
                                        <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>
                                        <ScrollViewer MaxHeight="240">
                                            <ItemsControl ItemsSource="{Binding AvailableCurrentModels}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Classes="model-item-btn"
                                                                Content="{Binding}"
                                                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectStudioModelCommand}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Padding="8,5" Margin="0,1" FontSize="11"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource OnlineBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveModelBadge}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="▾" FontSize="9" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Diagnostic Test Flight Action -->
                    <Button x:Name="DiagnosticTestFlightButton"
                            Command="{Binding OpenTestFlightCommand}"
                            Classes="matte-primary" Padding="12,6" FontSize="11" VerticalAlignment="Center"
                            ToolTip.Tip="Run diagnostic test flight across local engines">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconRocket}" Width="12" Height="12" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Diagnostic Test Flight" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 2: CENTER STAGE - PREVIEW CANVAS VIEWPORTS           -->
        <!-- ======================================================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <Panel>
                <!-- 1. IMAGE CANVAS VIEWPORT -->
                <StackPanel Spacing="12" IsVisible="{Binding IsImageModalityActive}">
                    <!-- Main Canvas Viewport Container -->
                    <Border Background="#0A101D" BorderBrush="#1B283C" BorderThickness="1" CornerRadius="12" Padding="16" BoxShadow="0 4 20 0 #30000000">
                        <Grid RowDefinitions="*, Auto">
                            <!-- Canvas Area / Pan-Zoom Preview -->
                            <Border Grid.Row="0" MinHeight="260" Background="#050812" CornerRadius="8" BorderBrush="#182335" BorderThickness="1">
                                <Grid>
                                    <!-- A: Real Rendered Image Display (when HasStudioGeneratedImage) -->
                                    <Grid IsVisible="{Binding HasStudioGeneratedImage}">
                                        <Border CornerRadius="8" ClipToBounds="True" Background="#02040A" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
                                            <Image Source="{Binding StudioGeneratedImageBytes, Converter={x:Static controls:ImageSourceConverter.Instance}}"
                                                   Stretch="Uniform" MaxHeight="520"/>
                                        </Border>

                                        <!-- Floating Action Bar for generated image -->
                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                                                Background="#E00A0F1D" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                                CornerRadius="20" Padding="8,4" BoxShadow="0 4 16 0 #80000000">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="💾 Save PNG" Command="{Binding SaveStudioImageCommand}"
                                                        Classes="matte-primary" FontSize="11" Padding="10,4"/>
                                                <Button Content="📋 Copy" Command="{Binding CopyStudioImageCommand}"
                                                        Classes="matte-secondary" FontSize="11" Padding="8,4"/>
                                                <Button Content="🗑️ Clear" Command="{Binding ClearStudioImageCommand}"
                                                        Classes="matte-secondary" FontSize="11" Padding="8,4"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- B: Loading State (when IsGeneratingStudioImage) -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="24"
                                                IsVisible="{Binding IsGeneratingStudioImage}">
                                        <ProgressBar Width="260" Height="6" IsIndeterminate="True"/>
                                        <TextBlock Text="{Binding StudioImageGenerationStatus}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Running local Stable Diffusion pipeline..." FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- C: Zero-State Prompt Suggestions (when ShowImageCanvasZeroState) -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="24"
                                                IsVisible="{Binding ShowImageCanvasZeroState}">
                                        <TextBlock Text="🎨" FontSize="44" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Interactive Image Canvas" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Ready for prompt generation via Stable Diffusion &amp; WebUI Forge." FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>

                                        <!-- Zero-State Prompt Suggestion Chips -->
                                        <TextBlock Text="Prompt Starter Ideas:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <WrapPanel HorizontalAlignment="Center" MaxWidth="720">
                                            <Button Classes="starter-chip" Margin="4" Content="✨ Cyberpunk street in neon rain, raytracing, octane render"
                                                    Command="{Binding ApplyPromptChipCommand}" CommandParameter="Cyberpunk street in neon rain, raytracing, octane render, 8k high detail"/>
                                            <Button Classes="starter-chip" Margin="4" Content="✨ Studio product shot of a sleek wireless mechanical keyboard"
                                                    Command="{Binding ApplyPromptChipCommand}" CommandParameter="Studio product shot of a sleek wireless mechanical keyboard, sharp focus, clean lighting"/>
                                            <Button Classes="starter-chip" Margin="4" Content="✨ Watercolor landscape of misty alpine peaks at sunrise"
                                                    Command="{Binding ApplyPromptChipCommand}" CommandParameter="Watercolor landscape of misty alpine peaks at sunrise, soft golden lighting, atmospheric"/>
                                            <Button Classes="starter-chip" Margin="4" Content="✨ Vintage Japanese woodblock print of a cosmic galaxy"
                                                    Command="{Binding ApplyPromptChipCommand}" CommandParameter="Vintage Japanese ukiyo-e woodblock print of a cosmic starry galaxy, detailed line art"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Canvas Viewport Controls Overlay -->
                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6" Margin="10">
                                        <Border Classes="matte-pill" Padding="6,2" Background="#CC0F172A">
                                            <TextBlock Text="{Binding ActiveModelBadge}" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                        </Border>
                                        <Border Classes="matte-pill" Padding="6,2" Background="#CC0F172A">
                                            <TextBlock Text="{Binding ActiveAspectPreset, StringFormat='Aspect: {0}'}" FontSize="10" Foreground="{StaticResource PrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Image Studio Preset Bar -->
                            <StackPanel Grid.Row="1" Spacing="6" Margin="0,12,0,0">
                                <TextBlock Text="Style Presets &amp; Quality Pathways" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                                <controls:StudioPresetBarControl
                                    Presets="{Binding ImagePresets}"
                                    SelectedPreset="{Binding SelectedImagePreset, Mode=TwoWay}"
                                    StarterPrompts="{Binding ImageStarterPrompts}"
                                    SavePresetCommand="{Binding SaveCurrentAsImagePresetCommand}"
                                    DeletePresetCommand="{Binding DeleteCurrentImagePresetCommand}"
                                    DuplicatePresetCommand="{Binding DuplicateCurrentImagePresetCommand}"
                                    ApplyStarterPromptCommand="{Binding ApplyStarterChipCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 2. TEXT STREAM VIEWPORT -->
                <StackPanel Spacing="12" IsVisible="{Binding IsTextModalityActive}">
                    <Border Background="#0A101D" BorderBrush="#1B283C" BorderThickness="1" CornerRadius="12" Padding="16" BoxShadow="0 4 20 0 #30000000">
                        <Grid RowDefinitions="Auto, *, Auto">
                            <!-- Stream Header & Active Model Badge -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="💬 Local LLM Reasoning Stream" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                                    <Border Classes="matte-pill" Padding="6,2" Background="#1E293B">
                                        <TextBlock Text="{Binding ActiveModelBadge}" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                    </Border>
                                    <Border Classes="matte-pill" Padding="6,2" Background="#064E3B" BorderBrush="#059669" BorderThickness="1">
                                        <TextBlock Text="{Binding ConfiguredContextTokens, StringFormat='ctx: {0:N0}'}" FontSize="10" Foreground="#34D399" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1" Content="📦 Browse Models" Command="{Binding NavigateToModelsTabCommand}" Classes="matte-secondary" Padding="8,4" FontSize="11"/>
                            </Grid>

                            <!-- Stream Content Area / Response Viewer -->
                            <Border Grid.Row="1" Background="#050812" CornerRadius="8" Padding="14" MinHeight="220" BorderBrush="#182335" BorderThickness="1">
                                <ScrollViewer MaxHeight="380">
                                    <Panel>
                                        <!-- Active Stream Response -->
                                        <SelectableTextBlock Text="{Binding OllamaResponseText}"
                                                              IsVisible="{Binding OllamaResponseText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                              TextWrapping="Wrap" FontSize="12" FontFamily="Consolas, monospace" Foreground="{StaticResource TextMainBrush}"/>

                                        <!-- Zero-State Prompt Suggestions when empty -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                                                    IsVisible="{Binding OllamaResponseText, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                            <TextBlock Text="💬" FontSize="40" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Ask Local LLM Engine" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="High-throughput reasoning running 100% privately on your hardware." FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>

                                            <WrapPanel HorizontalAlignment="Center" MaxWidth="680" Margin="0,8,0,0">
                                                <Button Classes="starter-chip" Margin="4" Content="💡 Explain difference between Flash Attention and Standard Attention"
                                                        Command="{Binding ApplyPromptChipCommand}" CommandParameter="Explain the difference between Flash Attention and Standard Attention in LLMs"/>
                                                <Button Classes="starter-chip" Margin="4" Content="💻 Write a high-performance C# SIMD vector processing method"
                                                        Command="{Binding ApplyPromptChipCommand}" CommandParameter="Write a high-performance C# method using System.Numerics.Vector to sum an array"/>
                                                <Button Classes="starter-chip" Margin="4" Content="🏗️ Design an event-driven microservices architecture"
                                                        Command="{Binding ApplyPromptChipCommand}" CommandParameter="Design a resilient event-driven microservices architecture using RabbitMQ and Redis"/>
                                                <Button Classes="starter-chip" Margin="4" Content="⚡ Summarize key architectural benefits of DeepSeek V3 MOE"
                                                        Command="{Binding ApplyPromptChipCommand}" CommandParameter="Summarize the key architectural innovations and efficiency benefits of DeepSeek V3 MOE"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Panel>
                                </ScrollViewer>
                            </Border>

                            <ProgressBar Grid.Row="2" IsVisible="{Binding IsGeneratingOllamaText}" IsIndeterminate="True" Height="4" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 3. VIDEO VIEWPORT -->
                <StackPanel Spacing="12" IsVisible="{Binding IsVideoModalityActive}">
                    <!-- Active 4-Stage Generation Tracker -->
                    <controls:GenerationStageTrackerControl
                        CurrentStage="{Binding GenerationStage}"
                        Stage1Status="{Binding Stage1Status}"
                        Stage2Status="{Binding Stage2Status}"
                        Stage3Status="{Binding Stage3Status}"
                        Stage4Status="{Binding Stage4Status}"
                        ProgressValue="{Binding VideoGenerationProgress}"
                        ElapsedTimerText="{Binding GenerationElapsedText}"
                        HardwareStatusBadgeText="{Binding HardwareStatusBadgeText}"
                        LogsText="{Binding LiveLogOutput}"
                        IsLogsExpanded="{Binding IsLiveLogsExpanded, Mode=TwoWay}"
                        IsActive="{Binding IsGeneratingVideo}"
                        CancelCommand="{Binding CancelGenerationCommand}"
                        IsVisible="{Binding IsGeneratingVideo}" />

                    <!-- Generous Video Player Container -->
                    <Border Background="#0A101D" BorderBrush="#1B283C" BorderThickness="1" CornerRadius="12" Padding="16" BoxShadow="0 4 20 0 #30000000">
                        <Grid RowDefinitions="*, Auto, Auto">
                            <Border Grid.Row="0" MinHeight="260" Background="#050812" CornerRadius="8" BorderBrush="#182335" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                        <TextBlock Text="🎬" FontSize="44" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Interactive Video Player Viewport" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding RenderedVideoUrl, FallbackValue='Wan 2.2 / LTX-2.5 DiT Video Pipeline Ready'}"
                                                   FontSize="11" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400"/>

                                        <!-- Zero-State Prompt Suggestions -->
                                        <WrapPanel HorizontalAlignment="Center" MaxWidth="680" Margin="0,8,0,0">
                                            <Button Classes="starter-chip" Margin="4" Content="🎬 Cinematic drone sweep over misty Nordic fjord at sunrise"
                                                    Command="{Binding ApplyPromptChipCommand}" CommandParameter="Cinematic drone shot flying through a misty Nordic fjord at sunrise, 4k ultra-detailed"/>
                                            <Button Classes="starter-chip" Margin="4" Content="🎬 Macro slow motion water droplet splashing with rainbow refraction"
                                                    Command="{Binding ApplyPromptChipCommand}" CommandParameter="Macro slow motion water droplet splashing onto a mirror with rainbow light refractions"/>
                                            <Button Classes="starter-chip" Margin="4" Content="🎬 Anime hero running through falling cherry blossom petals"
                                                    Command="{Binding ApplyPromptChipCommand}" CommandParameter="Anime hero running through falling cherry blossom petals, dynamic camera tracking"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Overlay Badges -->
                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10" Orientation="Horizontal" Spacing="6">
                                        <Border Classes="matte-pill" Padding="6,2" Background="#CC0F172A">
                                            <TextBlock Text="{Binding VideoDurationText, FallbackValue='5.0s'}" FontSize="10" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/>
                                        </Border>
                                        <Border Classes="matte-pill" Padding="6,2" Background="#CC0F172A">
                                            <TextBlock Text="{Binding VideoResolutionBadge, FallbackValue='832x480'}" FontSize="10" Foreground="{StaticResource SecondaryBrush}"/>
                                        </Border>
                                        <Border Classes="matte-pill" Padding="6,2" Background="#CC0F172A">
                                            <TextBlock Text="{Binding VideoFpsBadge, FallbackValue='16 FPS'}" FontSize="10" Foreground="{StaticResource TextMainBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Scrubber & Controls -->
                            <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,10,0,0">
                                <Button Grid.Column="0" Content="⏯️" Command="{Binding ToggleVideoPlayCommand}" Width="32" Height="32" Padding="0"/>
                                <Slider Grid.Column="1" Margin="8,0" Value="50" Minimum="0" Maximum="100"/>
                                <Button Grid.Column="2" Content="🔄" Command="{Binding ToggleVideoLoopCommand}" Width="32" Height="32" Padding="0" Margin="0,0,6,0"/>
                                <Button Grid.Column="3" Content="⬇️ Export" Command="{Binding DownloadVideoCommand}" Classes="matte-primary" Padding="10,4" FontSize="11"/>
                            </Grid>

                            <!-- Video Presets Bar -->
                            <StackPanel Grid.Row="2" Spacing="6" Margin="0,12,0,0">
                                <TextBlock Text="Video Presets &amp; Camera Motion" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                                <controls:StudioPresetBarControl
                                    Presets="{Binding VideoPresets}"
                                    SelectedPreset="{Binding SelectedVideoPreset, Mode=TwoWay}"
                                    StarterPrompts="{Binding VideoStarterPrompts}"
                                    SavePresetCommand="{Binding SaveCurrentAsVideoPresetCommand}"
                                    DeletePresetCommand="{Binding DeleteCurrentVideoPresetCommand}"
                                    DuplicatePresetCommand="{Binding DuplicateCurrentVideoPresetCommand}"
                                    ApplyStarterPromptCommand="{Binding ApplyStarterChipCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 4. 3D MESH VIEWPORT -->
                <StackPanel Spacing="12" IsVisible="{Binding Is3DModalityActive}">
                    <Border Background="#0A101D" BorderBrush="#1B283C" BorderThickness="1" CornerRadius="12" Padding="16" BoxShadow="0 4 20 0 #30000000">
                        <Grid RowDefinitions="*, Auto">
                            <Border Grid.Row="0" MinHeight="260" Background="#050812" CornerRadius="8" BorderBrush="#182335" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                        <TextBlock Text="🧊" FontSize="44" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Interactive 3D Mesh &amp; Splat Viewport" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="TRELLIS V2 &amp; Hunyuan3D Gaussian Splatting Engine" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>

                                        <!-- Zero-State Prompt Suggestions -->
                                        <WrapPanel HorizontalAlignment="Center" MaxWidth="680" Margin="0,8,0,0">
                                            <Button Classes="starter-chip" Margin="4" Content="🧊 Ancient mythical stone dragon statue with weathered moss"
                                                    Command="{Binding ApplyPromptChipCommand}" CommandParameter="Ancient mythical stone dragon statue with weathered moss and runes"/>
                                            <Button Classes="starter-chip" Margin="4" Content="🧊 Futuristic cybernetic skull with glowing blue optic wiring"
                                                    Command="{Binding ApplyPromptChipCommand}" CommandParameter="Futuristic cybernetic skull with exposed internal wiring and glowing optics"/>
                                            <Button Classes="starter-chip" Margin="4" Content="🧊 Low-poly stylized floating wizard tower island with waterfall"
                                                    Command="{Binding ApplyPromptChipCommand}" CommandParameter="Low-poly stylized floating wizard tower island with miniature waterfall"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- 3D Formats & Mesh Badges -->
                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10" Orientation="Horizontal" Spacing="6">
                                        <Border Classes="matte-pill" Padding="6,2" Background="#CC0F172A">
                                            <TextBlock Text="GLB / OBJ / PLY" FontSize="10" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/>
                                        </Border>
                                        <Border Classes="matte-pill" Padding="6,2" Background="#CC0F172A">
                                            <TextBlock Text="3DGS Gaussian Splats" FontSize="10" Foreground="{StaticResource SecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Format & Quality Pills -->
                            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Mesh Format:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <Border Classes="matte-pill" Padding="6,2"><TextBlock Text="GLB (Binary)" FontSize="10" FontWeight="SemiBold"/></Border>
                                    <Border Classes="matte-pill" Padding="6,2"><TextBlock Text="OBJ + MTL" FontSize="10"/></Border>
                                    <Border Classes="matte-pill" Padding="6,2"><TextBlock Text="Gaussian Splat (.ply)" FontSize="10"/></Border>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🌐 Open ComfyUI 3D" Command="{Binding OpenComfyWebUiCommand}" Classes="matte-secondary" Padding="10,4" FontSize="11"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 5. AUDIO VIEWPORT -->
                <StackPanel Spacing="12" IsVisible="{Binding IsAudioModalityActive}">
                    <Border Background="#0A101D" BorderBrush="#1B283C" BorderThickness="1" CornerRadius="12" Padding="16" BoxShadow="0 4 20 0 #30000000">
                        <Grid RowDefinitions="*, Auto">
                            <Border Grid.Row="0" MinHeight="260" Background="#050812" CornerRadius="8" BorderBrush="#182335" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                        <TextBlock Text="🎙️" FontSize="44" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Waveform Audio &amp; Speech Studio" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Kokoro TTS &amp; AudioCraft High-Speed Voice Engine" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>

                                        <!-- Zero-State Prompt Suggestions -->
                                        <WrapPanel HorizontalAlignment="Center" MaxWidth="680" Margin="0,8,0,0">
                                            <Button Classes="starter-chip" Margin="4" Content="🎙️ Cinematic deep brass orchestral swell with booming sub-bass"
                                                    Command="{Binding ApplyPromptChipCommand}" CommandParameter="Cinematic deep brass orchestral swell with booming sub-bass and tension strings"/>
                                            <Button Classes="starter-chip" Margin="4" Content="🎙️ Ambient rainy night lo-fi hip hop beat with warm electric piano"
                                                    Command="{Binding ApplyPromptChipCommand}" CommandParameter="Ambient rainy night lo-fi hip hop beat with warm electric piano and vinyl crackle"/>
                                            <Button Classes="starter-chip" Margin="4" Content="🎙️ Expressive bedtime story narration of a brave kitten"
                                                    Command="{Binding ApplyPromptChipCommand}" CommandParameter="Once upon a time in a starlit forest, a tiny brave kitten set out on a grand adventure."/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Audio Engine Badges -->
                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10" Orientation="Horizontal" Spacing="6">
                                        <Border Classes="matte-pill" Padding="6,2" Background="#CC0F172A">
                                            <TextBlock Text="Voice: af_heart" FontSize="10" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/>
                                        </Border>
                                        <Border Classes="matte-pill" Padding="6,2" Background="#CC0F172A">
                                            <TextBlock Text="48kHz 16-bit Stereo" FontSize="10" Foreground="{StaticResource SecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Audio Waveform Playback Bar -->
                            <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="▶️ Play" Classes="matte-primary" Padding="12,6" FontSize="11"/>
                                    <TextBlock Text="0:00 / 0:30" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Slider Grid.Column="1" Margin="16,0" Value="25" Minimum="0" Maximum="100"/>
                                <Button Grid.Column="2" Content="⬇️ Export WAV" Classes="matte-secondary" Padding="10,4" FontSize="11"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 6. STICKER STUDIO VIEWPORT -->
                <StackPanel Spacing="12" IsVisible="{Binding IsStickerModalityActive}">
                    <controls:StickerStudioControl DataContext="{Binding StickerStudio}"/>
                </StackPanel>
            </Panel>
        </ScrollViewer>

        <!-- ======================================================== -->
        <!-- ROW 3: BOTTOM CREATIVE PROMPT DOCK & PARAMETERS FLYOUT   -->
        <!-- ======================================================== -->
        <StackPanel Grid.Row="3" Spacing="6">
            <!-- PARAMETERS SLIDE-UP POPOVER / FLYOUT PANEL -->
            <Border Background="#0C1425"
                    BorderBrush="#2563EB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14"
                    BoxShadow="0 -8 32 0 #60000000"
                    IsVisible="{Binding Studio.IsParametersFlyoutOpen}"
                    Margin="0,0,0,4">
                <Grid RowDefinitions="Auto, Auto, Auto">
                    <!-- Flyout Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="⚙️ Fine-Tuning Generation Parameters" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                            <Border Background="#1E293B" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{Binding Studio.ActiveAspectPreset, StringFormat='Aspect: {0}'}" FontSize="10" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding Studio.ToggleParametersFlyoutCommand}" Classes="matte-secondary" Padding="8,2" FontSize="10"/>
                    </Grid>

                    <!-- Active Model / Checkpoint Selection Row -->
                    <Border Grid.Row="1" Background="#0C1220" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="📦 Active Model:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding AvailableCurrentModels}"
                                          SelectedItem="{Binding SelectedStudioModelText, Mode=TwoWay}"
                                          MinWidth="260" MaxDropDownHeight="240"
                                          FontSize="11"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="🔄 Rescan Local Models" Command="{Binding RefreshScannedModelsCommand}" Classes="matte-secondary" Padding="8,4" FontSize="11"/>
                        </Grid>
                    </Border>

                    <!-- Sliders & Inputs -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, *, *, *, *">
                        <!-- Steps -->
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="Steps" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding StudioSteps}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <Slider Minimum="10" Maximum="100" Value="{Binding StudioSteps}"/>
                        </StackPanel>

                        <!-- CFG Scale -->
                        <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,10,0">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="CFG Scale" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding StudioCfgScale, StringFormat='{}{0:F1}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <Slider Minimum="1.0" Maximum="20.0" Value="{Binding StudioCfgScale}"/>
                        </StackPanel>

                        <!-- Denoise -->
                        <StackPanel Grid.Column="2" Spacing="4" Margin="4,0,10,0">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="Denoise" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding StudioDenoise, StringFormat='{}{0:F2}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding StudioDenoise}"/>
                        </StackPanel>

                        <!-- Seed -->
                        <StackPanel Grid.Column="3" Spacing="4" Margin="4,0,10,0">
                            <TextBlock Text="Seed (-1 = Random)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <NumericUpDown Value="{Binding StudioSeed}" Minimum="-1" Maximum="999999999" Height="28"/>
                        </StackPanel>

                        <!-- Aspect Ratio Selector -->
                        <StackPanel Grid.Column="4" Spacing="4" Margin="4,0,0,0">
                            <TextBlock Text="Aspect Ratio" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="aspect-pill" Classes.active="{Binding IsAspectSquareActive}" Content="1:1" Command="{Binding SelectAspectPresetCommand}" CommandParameter="1:1"/>
                                <Button Classes="aspect-pill" Classes.active="{Binding IsAspectLandscapeActive}" Content="16:9" Command="{Binding SelectAspectPresetCommand}" CommandParameter="16:9"/>
                                <Button Classes="aspect-pill" Classes.active="{Binding IsAspectPortraitActive}" Content="9:16" Command="{Binding SelectAspectPresetCommand}" CommandParameter="9:16"/>
                                <Button Classes="aspect-pill" Classes.active="{Binding IsAspectStandardActive}" Content="4:3" Command="{Binding SelectAspectPresetCommand}" CommandParameter="4:3"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- CHAT-STYLE CREATIVE PROMPT DOCK -->
            <Border Background="#090E1A"
                    BorderBrush="#1F2E44"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 -4 20 0 #40000000"
                    Padding="14,10">
                <Grid RowDefinitions="Auto, Auto">
                    <!-- Multi-Line Autosizing Prompt Textarea -->
                    <TextBox x:Name="PromptDockInput"
                             Text="{Binding PromptText}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="46"
                             MaxHeight="120"
                             PlaceholderText="{Binding ActivePromptPlaceholder}"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="13"
                             Foreground="#F8FAFC"/>

                    <!-- Context Pill Bar -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" Margin="0,8,0,0">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Dynamic Interactive Active Model Selector Pill -->
                            <Button Classes="model-badge-btn" ToolTip.Tip="Click to switch model / workflow">
                                <Button.Flyout>
                                    <Flyout Placement="Top">
                                        <Border Background="#0D1322" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MinWidth="260" MaxWidth="340">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*, Auto" Margin="4,2">
                                                    <TextBlock Text="Select Active Model" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="🔄 Scan" Command="{Binding RefreshScannedModelsCommand}" Classes="matte-secondary" Padding="6,2" FontSize="10"/>
                                                </Grid>
                                                <Rectangle Height="1" Fill="{StaticResource GlassBorderBrush}"/>
                                                <ScrollViewer MaxHeight="240">
                                                    <ItemsControl ItemsSource="{Binding AvailableCurrentModels}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Classes="model-item-btn"
                                                                        Content="{Binding}"
                                                                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectStudioModelCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Left"
                                                                        Padding="8,5" Margin="0,1" FontSize="11"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource OnlineBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ActiveModelBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="▾" FontSize="9" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Attachment Button -->
                            <Button Command="{Binding AttachImageCommand}" Classes="matte-secondary" Padding="8,4" FontSize="11" ToolTip.Tip="Attach reference image">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="📎" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="Attach" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Attachment Indicator Pill -->
                            <Border IsVisible="{Binding HasAttachedImage}" Background="#1E293B" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="12" Padding="6,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="🖼️ Image Attached" FontSize="10" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Content="✕" Command="{Binding RemoveAttachedImageCommand}" Classes="matte-secondary" Padding="4,1" FontSize="9" VerticalAlignment="Center" ToolTip.Tip="Remove reference image"/>
                                </StackPanel>
                            </Border>

                            <!-- Parameters Toggle Button -->
                            <Button Command="{Binding Studio.ToggleParametersFlyoutCommand}" Classes="matte-secondary" Padding="8,4" FontSize="11" ToolTip.Tip="Open fine-tuning sliders">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="⚙️" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Quick Aspect Ratio Presets directly in Dock -->
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,0,0,0" VerticalAlignment="Center">
                                <Button Classes="aspect-pill" Classes.active="{Binding IsAspectSquareActive}" Content="1:1" Command="{Binding SelectAspectPresetCommand}" CommandParameter="1:1" ToolTip.Tip="Square 1:1"/>
                                <Button Classes="aspect-pill" Classes.active="{Binding IsAspectLandscapeActive}" Content="16:9" Command="{Binding SelectAspectPresetCommand}" CommandParameter="16:9" ToolTip.Tip="Landscape 16:9"/>
                                <Button Classes="aspect-pill" Classes.active="{Binding IsAspectPortraitActive}" Content="9:16" Command="{Binding SelectAspectPresetCommand}" CommandParameter="9:16" ToolTip.Tip="Portrait 9:16"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Prominent Generate Action Button & Live Progress Feedback -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Live Generation Status Pill -->
                            <Border IsVisible="{Binding IsGeneratingAnyStudio}"
                                    Background="#0F172A"
                                    BorderBrush="#38BDF8"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,5"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ProgressBar Width="70" Height="6" Minimum="0" Maximum="1" Value="{Binding StudioImageGenerationProgress}"
                                                 VerticalAlignment="Center" Foreground="#38BDF8" Background="#1E293B"/>
                                    <TextBlock Text="{Binding StudioImageGenerationStatus}"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Foreground="#93C5FD"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding GenerateFromDockCommand}"
                                    IsEnabled="{Binding !IsGeneratingAnyStudio}"
                                    Background="#2563EB"
                                    Foreground="White"
                                    CornerRadius="8"
                                    Padding="20,8"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StudioGenerateButtonText}" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ======================================================== -->
        <!-- MODAL OVERLAY: DIAGNOSTIC TEST FLIGHT MODAL              -->
        <!-- ======================================================== -->
        <controls:TestFlightModalControl DataContext="{Binding}"
                                         IsVisible="{Binding IsTestFlightOpen}"
                                         ZIndex="100"/>
    </Grid>
</UserControl>
