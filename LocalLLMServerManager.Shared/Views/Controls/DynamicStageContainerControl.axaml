<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             xmlns:models="using:LocalLLMServerManager.Shared.Models"
             xmlns:controls="using:LocalLLMServerManager.Shared.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.DynamicStageContainerControl"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- Hide the TabStrip header border because navigation is hosted in the left ActivityRailControl -->
        <Style Selector="TabControl.stage-tabs /template/ DockPanel > Border">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TabControl.stage-tabs /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Button.workflow-tab-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.workflow-tab-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.workflow-tab-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
        </Style>
        <Style Selector="Button.workflow-tab-btn.active">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
        </Style>
        <Style Selector="Button.workflow-tab-btn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1A388BFD" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
        </Style>

        <Style Selector="Button.workflow-sub-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.workflow-sub-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
        </Style>
    </UserControl.Styles>

    <TabControl Classes="stage-tabs" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent">
        <!-- TAB 0: Models (Downloaded, Hugging Face Hub, CivitAI Hub) -->
        <TabItem Header="Models">
            <controls:ModelsTabControl DataContext="{Binding}" Margin="16,0,16,16"/>
        </TabItem>

        <!-- TAB 1: Studio Workflows (Sticker Studio + Engine Workflows) -->
        <TabItem Header="Studio">
            <Grid RowDefinitions="Auto, *">
                <!-- Studio Sub-Navigation Bar: Direct Modality Workflows & Sticker Studio -->
                <Border Grid.Row="0"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,6">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <!-- Direct flat workflow buttons on the left -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Images Workflow Button -->
                            <Button Classes="workflow-tab-btn"
                                    Classes.active="{Binding IsImagesWorkflowActive}"
                                    Command="{Binding SwitchToEngineWorkflowCommand}"
                                    CommandParameter="Images"
                                    ToolTip.Tip="Images: Stable Diffusion &amp; Forge SD">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconImages}" Width="14" Height="14"
                                              Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Images" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Text Workflow Button -->
                            <Button Classes="workflow-tab-btn"
                                    Classes.active="{Binding IsTextWorkflowActive}"
                                    Command="{Binding SwitchToEngineWorkflowCommand}"
                                    CommandParameter="Text"
                                    ToolTip.Tip="Text: Ollama Local LLM Reasoning">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconText}" Width="14" Height="14"
                                              Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Text" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Video Workflow Button -->
                            <Button Classes="workflow-tab-btn"
                                    Classes.active="{Binding IsVideoWorkflowActive}"
                                    Command="{Binding SwitchToEngineWorkflowCommand}"
                                    CommandParameter="Video"
                                    ToolTip.Tip="Video: ComfyUI, Wan 2.2 &amp; AnimateDiff">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconVideo}" Width="14" Height="14"
                                              Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Video" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 3D Mesh Workflow Button -->
                            <Button Classes="workflow-tab-btn"
                                    Classes.active="{Binding Is3DMeshWorkflowActive}"
                                    Command="{Binding SwitchToEngineWorkflowCommand}"
                                    CommandParameter="3D Mesh"
                                    ToolTip.Tip="3D Mesh: Hunyuan3D &amp; TripoSR Generation">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource Icon3D}" Width="14" Height="14"
                                              Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                                    <TextBlock Text="3D Mesh" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Audio Workflow Button -->
                            <Button Classes="workflow-tab-btn"
                                    Classes.active="{Binding IsAudioWorkflowActive}"
                                    Command="{Binding SwitchToEngineWorkflowCommand}"
                                    CommandParameter="Audio"
                                    ToolTip.Tip="Audio: Kokoro Speech &amp; AudioCraft">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconAudio}" Width="14" Height="14"
                                              Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Audio" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Rectangle Width="1" Height="18" Fill="{StaticResource GlassBorderBrush}" Margin="4,0" VerticalAlignment="Center"/>

                            <!-- Sticker Studio Button -->
                            <Button Classes="workflow-tab-btn"
                                    Classes.active="{Binding IsStickerStudioActive}"
                                    Command="{Binding SwitchToStickerStudioCommand}"
                                    ToolTip.Tip="Sticker Studio: Reference image to die-cut vinyl sticker generation">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconSticker}" Width="14" Height="14"
                                              Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sticker Studio" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Right Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="StageDiagnosticTestFlightButton"
                                    Classes="matte-primary"
                                    Command="{Binding OpenTestFlightCommand}"
                                    ToolTip.Tip="Run diagnostic test flight across engines"
                                    Padding="12,4" Height="28">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconRocket}" Width="12" Height="12" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="Diagnostic Test Flight" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Studio Stage Area -->
                <Panel Grid.Row="1">
                    <!-- Sticker Studio Control (Default Dual-Stage Canvas) -->
                    <Panel IsVisible="{Binding IsStickerStudioActive}">
                        <controls:StickerStudioControl DataContext="{Binding StickerStudio}"/>
                    </Panel>

                    <!-- Engine Studio Control (Workflows: Image, Text, Video, 3D Mesh, Audio) -->
                    <Panel IsVisible="{Binding !IsStickerStudioActive}">
                        <controls:EngineStudioTabControl DataContext="{Binding}"
                                                         Margin="16,0,16,16"/>
                    </Panel>
                </Panel>
            </Grid>
        </TabItem>

        <!-- TAB 2: Can I Run It Hardware Fit Calculator -->
        <TabItem Header="HardwareFit">
            <controls:CanIRunItView DataContext="{Binding HardwareFit}" Margin="16,0,16,16"/>
        </TabItem>

        <!-- TAB 3: Remote Access & Settings -->
        <TabItem Header="Settings">
            <controls:SettingsTabControl DataContext="{Binding Settings}" Margin="16,0,16,16"/>
        </TabItem>
    </TabControl>
</UserControl>
