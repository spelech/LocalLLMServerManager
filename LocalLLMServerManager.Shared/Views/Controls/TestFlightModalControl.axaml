<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:LocalLLMServerManager.Shared.Models"
             xmlns:controls="using:LocalLLMServerManager.Shared.Views.Controls"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.TestFlightModalControl"
             x:Name="RootControl">

    <Border Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20">
        <StackPanel Spacing="16">
            <!-- Header Row -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🚀" FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Text="Studio Diagnostic Test Flight" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Verify your local GPU, model weights, and engine pipeline with a single-click dry run."
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="1"
                        Content="✕"
                        Command="{Binding CloseCommand, ElementName=RootControl}"
                        Classes="matte-secondary"
                        Padding="8,4"
                        FontSize="13"
                        VerticalAlignment="Top"/>
            </Grid>

            <!-- Modality Selector -->
            <StackPanel Spacing="6">
                <TextBlock Text="Select Test Modality:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton Content="🎨 Image (SD / Forge)"
                                 GroupName="TestFlightModality"
                                 IsChecked="{Binding SelectedModality, ElementName=RootControl, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:StudioModality.Image}}"
                                 Command="{Binding SelectModalityCommand, ElementName=RootControl}"
                                 CommandParameter="{x:Static models:StudioModality.Image}"
                                 Classes="matte-radio"/>
                    <RadioButton Content="🎬 Video (Wan / ComfyUI)"
                                 GroupName="TestFlightModality"
                                 IsChecked="{Binding SelectedModality, ElementName=RootControl, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:StudioModality.Video}}"
                                 Command="{Binding SelectModalityCommand, ElementName=RootControl}"
                                 CommandParameter="{x:Static models:StudioModality.Video}"
                                 Classes="matte-radio"/>
                    <RadioButton Content="🎵 Audio / TTS (Kokoro)"
                                 GroupName="TestFlightModality"
                                 IsChecked="{Binding SelectedModality, ElementName=RootControl, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:StudioModality.Audio}}"
                                 Command="{Binding SelectModalityCommand, ElementName=RootControl}"
                                 CommandParameter="{x:Static models:StudioModality.Audio}"
                                 Classes="matte-radio"/>
                </StackPanel>
            </StackPanel>

            <!-- Engine & Hardware Status Checks -->
            <StackPanel Spacing="6">
                <TextBlock Text="Hardware &amp; Engine Pre-Flight Checks:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="matte-pill" Padding="10,6">
                        <TextBlock Text="{Binding EngineStatusText, ElementName=RootControl}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnlineBrush}"/>
                    </Border>
                    <Border Classes="matte-pill" Padding="10,6">
                        <TextBlock Text="{Binding VramStatusText, ElementName=RootControl}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Starter Prompt Picker & Description -->
            <StackPanel Spacing="6">
                <TextBlock Text="Test Preset &amp; Starter Prompt:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                <ComboBox ItemsSource="{Binding StarterPrompts, ElementName=RootControl}"
                          SelectedItem="{Binding SelectedStarterPrompt, ElementName=RootControl}"
                          HorizontalAlignment="Stretch"
                          Classes="matte-input">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="models:StudioPreset">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Prompt Preview -->
                <Border Classes="matte-pill" Padding="10,8" Background="{StaticResource BgSurfaceBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Prompt Preview:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding SelectedStarterPrompt.SamplePrompt, ElementName=RootControl}"
                                   FontSize="11" Foreground="{StaticResource TextMainBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Action Button & Mini Stepper Progress -->
            <StackPanel Spacing="10">
                <Button Content="🚀 Launch Test Flight"
                        Command="{Binding LaunchTestFlightCommand, ElementName=RootControl}"
                        IsEnabled="{Binding !IsRunning, ElementName=RootControl}"
                        Classes="matte-primary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="14,10"
                        FontSize="13"/>

                <!-- Mini Stepper Progress -->
                <StackPanel Spacing="6" IsVisible="{Binding IsRunning, ElementName=RootControl}">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="{Binding StatusMessage, ElementName=RootControl}"
                                   FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProgressValue, ElementName=RootControl, StringFormat='{}{0:0}%'}"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                    <ProgressBar Classes="matte-progress"
                                 Value="{Binding ProgressValue, ElementName=RootControl}"
                                 IsIndeterminate="{Binding IsIndeterminate, ElementName=RootControl}"
                                 Minimum="0" Maximum="100" Height="6"/>
                </StackPanel>
            </StackPanel>

            <!-- Success Result Banner -->
            <Border IsVisible="{Binding IsSuccess, ElementName=RootControl}"
                    Background="#193623"
                    BorderBrush="{StaticResource OnlineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ResultBannerText, ElementName=RootControl}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnlineBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Done"
                            Command="{Binding CloseCommand, ElementName=RootControl}"
                            Classes="matte-primary" Padding="12,6" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Error Banner -->
            <Border IsVisible="{Binding HasError, ElementName=RootControl}"
                    Background="#3A1C20"
                    BorderBrush="{StaticResource OfflineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <StackPanel Spacing="4">
                    <TextBlock Text="⚠️ Test Flight Failed" FontSize="12" FontWeight="Bold" Foreground="{StaticResource OfflineBrush}"/>
                    <TextBlock Text="{Binding ErrorMessage, ElementName=RootControl}" FontSize="11" Foreground="{StaticResource TextMainBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
