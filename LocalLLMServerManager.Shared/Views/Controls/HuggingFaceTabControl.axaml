<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.HuggingFaceTabControl"
             x:DataType="vm:HuggingFaceSearchViewModel">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="0,12,0,0">
        <!-- Search Input Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0" Text="{Binding HfSearchQuery}" PlaceholderText="Search Hugging Face models (e.g. llama 3.3, Wan, LTX, Kokoro, Qwen2-VL)..."
                     Classes="matte-input" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Command="{Binding SearchHuggingFaceCommand}" 
                    Classes="matte-primary" Margin="8,0,0,0" VerticalAlignment="Center">
                🔍 Search Hub
            </Button>
        </Grid>

        <!-- Quick Presets Row -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="🌟 Multimodal / VLM" Command="{Binding ApplyPresetCommand}" CommandParameter="Multimodal" Classes="matte-pill"/>
                <Button Content="🦙 Text LLM" Command="{Binding ApplyPresetCommand}" CommandParameter="LLM" Classes="matte-pill"/>
                <Button Content="🎨 Text-to-Image" Command="{Binding ApplyPresetCommand}" CommandParameter="Image" Classes="matte-pill"/>
                <Button Content="🎬 Video Gen" Command="{Binding ApplyPresetCommand}" CommandParameter="Video" Classes="matte-pill"/>
                <Button Content="🔊 Speech &amp; Audio" Command="{Binding ApplyPresetCommand}" CommandParameter="Audio" Classes="matte-pill"/>
                <Button Content="📦 3D Mesh" Command="{Binding ApplyPresetCommand}" CommandParameter="3D" Classes="matte-pill"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Modality Matrix & Hardware Compatibility Filter -->
        <Border Grid.Row="2" Classes="matte-card" Margin="0,0,0,10" Padding="12,10">
            <StackPanel Spacing="8">
                <!-- Inputs & Outputs Matrix -->
                <Grid ColumnDefinitions="Auto, *, Auto, *">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Inputs:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="Text" Command="{Binding ToggleInputModalityCommand}" CommandParameter="Text" Classes="matte-pill" Padding="6,2"/>
                        <Button Content="Image" Command="{Binding ToggleInputModalityCommand}" CommandParameter="Image" Classes="matte-pill" Padding="6,2"/>
                        <Button Content="Audio" Command="{Binding ToggleInputModalityCommand}" CommandParameter="Audio" Classes="matte-pill" Padding="6,2"/>
                        <Button Content="Video" Command="{Binding ToggleInputModalityCommand}" CommandParameter="Video" Classes="matte-pill" Padding="6,2"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Outputs:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <Button Content="Text" Command="{Binding ToggleOutputModalityCommand}" CommandParameter="Text" Classes="matte-pill" Padding="6,2"/>
                        <Button Content="Image" Command="{Binding ToggleOutputModalityCommand}" CommandParameter="Image" Classes="matte-pill" Padding="6,2"/>
                        <Button Content="Audio" Command="{Binding ToggleOutputModalityCommand}" CommandParameter="Audio" Classes="matte-pill" Padding="6,2"/>
                        <Button Content="Video" Command="{Binding ToggleOutputModalityCommand}" CommandParameter="Video" Classes="matte-pill" Padding="6,2"/>
                        <Button Content="3D" Command="{Binding ToggleOutputModalityCommand}" CommandParameter="3D" Classes="matte-pill" Padding="6,2"/>
                    </StackPanel>
                </Grid>

                <!-- Hardware Compatibility Filter Chips -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Hardware Filter:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="FullVram" Classes="matte-pill" Padding="6,2">
                        <TextBlock Text="🟢 Full VRAM" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                    </Button>
                    <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="PartialOffload" Classes="matte-pill" Padding="6,2">
                        <TextBlock Text="🟡 Partial Offload" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                    </Button>
                    <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="CpuOnly" Classes="matte-pill" Padding="6,2">
                        <TextBlock Text="🟠 CPU Only" FontSize="11" FontWeight="Bold" Foreground="#F97316"/>
                    </Button>
                    <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="OutOfMemory" Classes="matte-pill" Padding="6,2">
                        <TextBlock Text="🔴 Won't Fit" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding FilteredHuggingFaceResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:HuggingFaceRepoItem">
                        <Border Classes="matte-card" Margin="0,0,0,8" Padding="14,12">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SecondaryBrush}"/>
                                    <TextBlock Text="{Binding Author, StringFormat='Author: {0}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Ambient Compatibility Pill with Click-to-Inspect -->
                                    <Button Command="{Binding $parent[UserControl].((vm:HuggingFaceSearchViewModel)DataContext).InspectModelCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#1E293B"
                                            BorderBrush="{Binding FitBadge.BadgeColorHex}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,4"
                                            ToolTip.Tip="{Binding FitBadge.Tooltip}"
                                            IsVisible="{Binding FitBadge, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Cursor="Hand"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding FitBadge.BadgeText}" FontSize="11" Foreground="{Binding FitBadge.BadgeColorHex}" FontWeight="Bold"/>
                                            <TextBlock Text="⚡ Check Fit" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Border Classes="matte-pill" Padding="8,4" IsVisible="{Binding PipelineTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding PipelineTag}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Classes="matte-pill" Padding="8,4">
                                        <TextBlock Text="{Binding Downloads, StringFormat='⬇️ {0:N0}'}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Classes="matte-pill" Padding="8,4">
                                        <TextBlock Text="{Binding Likes, StringFormat='❤️ {0:N0}'}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Modal overlay for fetching quant files -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#AA000000" IsVisible="{Binding IsHfModalOpen}" ZIndex="50">
            <Border Classes="matte-card" Width="550" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding ModalRepoId}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SecondaryBrush}"/>
                            <TextBlock Text="{Binding ModalAuthor, StringFormat='Author: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseHfModalCommand}" Classes="matte-secondary" Padding="8,4"/>
                    </Grid>
                    <TextBlock Text="Available GGUF Quantizations" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                    <ScrollViewer MaxHeight="300">
                        <ItemsControl ItemsSource="{Binding ModalHfFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:HfFileQuantItem">
                                    <Border Classes="matte-card" Margin="0,0,0,6" Padding="10,8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding Filename}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Classes="matte-pill" Padding="6,2">
                                                        <TextBlock Text="{Binding Quantization}" FontSize="10" Foreground="{StaticResource SecondaryBrush}" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Classes="matte-pill" Padding="6,2">
                                                        <TextBlock Text="{Binding FormatSize}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Command="{Binding $parent[UserControl].((vm:HuggingFaceSearchViewModel)DataContext).InspectQuantFileCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="#1E293B"
                                                    BorderBrush="{Binding FitBadge.BadgeColorHex}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    ToolTip.Tip="{Binding FitBadge.Tooltip}"
                                                    IsVisible="{Binding FitBadge, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding FitBadge.BadgeText}" FontSize="11" Foreground="{Binding FitBadge.BadgeColorHex}" FontWeight="Bold"/>
                                                    <TextBlock Text="⚡ Check Fit" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
