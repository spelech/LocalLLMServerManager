<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             x:Class="LocalLLMServerManager.Shared.Views.Controls.HuggingFaceTabControl"
             x:DataType="vm:HuggingFaceSearchViewModel">

    <UserControl.Styles>
        <!-- Quick Presets -->
        <Style Selector="Button.preset-btn">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.preset-btn:pointerover">
            <Setter Property="Background" Value="#334155"/>
        </Style>
        <Style Selector="Button.preset-btn.active">
            <Setter Property="Background" Value="#0D9488"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2DD4BF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.preset-btn.active:pointerover">
            <Setter Property="Background" Value="#0F766E"/>
        </Style>

        <!-- Input Modality Buttons -->
        <Style Selector="Button.input-modality-btn">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.input-modality-btn:pointerover">
            <Setter Property="Background" Value="#334155"/>
        </Style>
        <Style Selector="Button.input-modality-btn.active">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#60A5FA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.input-modality-btn.active:pointerover">
            <Setter Property="Background" Value="#2563EB"/>
        </Style>

        <!-- Output Modality Buttons -->
        <Style Selector="Button.output-modality-btn">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.output-modality-btn:pointerover">
            <Setter Property="Background" Value="#334155"/>
        </Style>
        <Style Selector="Button.output-modality-btn.active">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C084FC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.output-modality-btn.active:pointerover">
            <Setter Property="Background" Value="#6D28D9"/>
        </Style>

        <!-- Hardware Filter Buttons -->
        <Style Selector="Button.hw-filter-btn">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <Style Selector="Button.hw-filter-btn:pointerover">
            <Setter Property="Background" Value="#334155"/>
        </Style>
        <Style Selector="Button.hw-filter-btn.inactive">
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
        <Style Selector="Button.hw-filter-btn.inactive:pointerover">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Background" Value="#1E293B"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Margin="0,12,0,0">
        <!-- Search Input Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0" Text="{Binding HfSearchQuery}" PlaceholderText="Search Hugging Face models (e.g. llama 3.3, Wan, LTX, Kokoro, Qwen2-VL)..."
                     Classes="matte-input" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Command="{Binding SearchHuggingFaceCommand}" 
                    IsEnabled="{Binding !IsLoading}"
                    Classes="matte-primary" Margin="8,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🔍" IsVisible="{Binding !IsLoading}"/>
                    <TextBlock Text="⏳" IsVisible="{Binding IsLoading}"/>
                    <TextBlock Text="Search Hub" IsVisible="{Binding !IsLoading}"/>
                    <TextBlock Text="Searching Hub..." IsVisible="{Binding IsLoading}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Search Loading Indicator -->
        <Border Grid.Row="1" IsVisible="{Binding IsLoading}" Background="#1E293B" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto, *">
                <TextBlock Grid.Column="0" Text="🔄 Querying Hugging Face Hub API..." FontSize="12" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" IsIndeterminate="True" Height="4" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Quick Presets Row -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Command="{Binding ApplyPresetCommand}" CommandParameter="Multimodal" Classes="preset-btn" Classes.active="{Binding IsPresetMultimodal}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="✓" IsVisible="{Binding IsPresetMultimodal}" FontWeight="Bold"/>
                        <TextBlock Text="🌟 Multimodal / VLM"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ApplyPresetCommand}" CommandParameter="LLM" Classes="preset-btn" Classes.active="{Binding IsPresetLlm}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="✓" IsVisible="{Binding IsPresetLlm}" FontWeight="Bold"/>
                        <TextBlock Text="🦙 Text LLM"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ApplyPresetCommand}" CommandParameter="Image" Classes="preset-btn" Classes.active="{Binding IsPresetImage}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="✓" IsVisible="{Binding IsPresetImage}" FontWeight="Bold"/>
                        <TextBlock Text="🎨 Text-to-Image"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ApplyPresetCommand}" CommandParameter="Video" Classes="preset-btn" Classes.active="{Binding IsPresetVideo}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="✓" IsVisible="{Binding IsPresetVideo}" FontWeight="Bold"/>
                        <TextBlock Text="🎬 Video Gen"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ApplyPresetCommand}" CommandParameter="Audio" Classes="preset-btn" Classes.active="{Binding IsPresetAudio}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="✓" IsVisible="{Binding IsPresetAudio}" FontWeight="Bold"/>
                        <TextBlock Text="🔊 Speech &amp; Audio"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ApplyPresetCommand}" CommandParameter="3D" Classes="preset-btn" Classes.active="{Binding IsPreset3D}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="✓" IsVisible="{Binding IsPreset3D}" FontWeight="Bold"/>
                        <TextBlock Text="📦 3D Mesh"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Modality Matrix & Hardware Compatibility Filter -->
        <Border Grid.Row="3" Classes="matte-card" Margin="0,0,0,10" Padding="12,10">
            <StackPanel Spacing="10">
                <!-- Inputs & Outputs Matrix -->
                <Grid ColumnDefinitions="Auto, *, Auto, *">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Inputs:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <Button Command="{Binding ToggleInputModalityCommand}" CommandParameter="Text" Classes="input-modality-btn" Classes.active="{Binding IsInputTextActive}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="✓" IsVisible="{Binding IsInputTextActive}" FontWeight="Bold"/>
                                <TextBlock Text="Text"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleInputModalityCommand}" CommandParameter="Image" Classes="input-modality-btn" Classes.active="{Binding IsInputImageActive}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="✓" IsVisible="{Binding IsInputImageActive}" FontWeight="Bold"/>
                                <TextBlock Text="Image"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleInputModalityCommand}" CommandParameter="Audio" Classes="input-modality-btn" Classes.active="{Binding IsInputAudioActive}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="✓" IsVisible="{Binding IsInputAudioActive}" FontWeight="Bold"/>
                                <TextBlock Text="Audio"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleInputModalityCommand}" CommandParameter="Video" Classes="input-modality-btn" Classes.active="{Binding IsInputVideoActive}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="✓" IsVisible="{Binding IsInputVideoActive}" FontWeight="Bold"/>
                                <TextBlock Text="Video"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Outputs:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <Button Command="{Binding ToggleOutputModalityCommand}" CommandParameter="Text" Classes="output-modality-btn" Classes.active="{Binding IsOutputTextActive}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="✓" IsVisible="{Binding IsOutputTextActive}" FontWeight="Bold"/>
                                <TextBlock Text="Text"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleOutputModalityCommand}" CommandParameter="Image" Classes="output-modality-btn" Classes.active="{Binding IsOutputImageActive}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="✓" IsVisible="{Binding IsOutputImageActive}" FontWeight="Bold"/>
                                <TextBlock Text="Image"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleOutputModalityCommand}" CommandParameter="Audio" Classes="output-modality-btn" Classes.active="{Binding IsOutputAudioActive}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="✓" IsVisible="{Binding IsOutputAudioActive}" FontWeight="Bold"/>
                                <TextBlock Text="Audio"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleOutputModalityCommand}" CommandParameter="Video" Classes="output-modality-btn" Classes.active="{Binding IsOutputVideoActive}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="✓" IsVisible="{Binding IsOutputVideoActive}" FontWeight="Bold"/>
                                <TextBlock Text="Video"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleOutputModalityCommand}" CommandParameter="3D" Classes="output-modality-btn" Classes.active="{Binding IsOutputThreeDActive}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="✓" IsVisible="{Binding IsOutputThreeDActive}" FontWeight="Bold"/>
                                <TextBlock Text="3D"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Hardware Compatibility Filter Chips -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Hardware Filter:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="FullVram" Classes="hw-filter-btn" Classes.inactive="{Binding !IsFullVramActive}" BorderBrush="#10B981">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="✓" IsVisible="{Binding IsFullVramActive}" Foreground="#10B981" FontWeight="Bold"/>
                            <TextBlock Text="✕" IsVisible="{Binding !IsFullVramActive}" Foreground="#64748B"/>
                            <TextBlock Text="🟢 Full VRAM" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="PartialOffload" Classes="hw-filter-btn" Classes.inactive="{Binding !IsPartialOffloadActive}" BorderBrush="#F59E0B">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="✓" IsVisible="{Binding IsPartialOffloadActive}" Foreground="#F59E0B" FontWeight="Bold"/>
                            <TextBlock Text="✕" IsVisible="{Binding !IsPartialOffloadActive}" Foreground="#64748B"/>
                            <TextBlock Text="🟡 Partial Offload" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="CpuOnly" Classes="hw-filter-btn" Classes.inactive="{Binding !IsCpuOnlyActive}" BorderBrush="#F97316">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="✓" IsVisible="{Binding IsCpuOnlyActive}" Foreground="#F97316" FontWeight="Bold"/>
                            <TextBlock Text="✕" IsVisible="{Binding !IsCpuOnlyActive}" Foreground="#64748B"/>
                            <TextBlock Text="🟠 CPU Only" FontSize="11" FontWeight="Bold" Foreground="#F97316"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleFitVerdictCommand}" CommandParameter="OutOfMemory" Classes="hw-filter-btn" Classes.inactive="{Binding !IsOomActive}" BorderBrush="#EF4444">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="✓" IsVisible="{Binding IsOomActive}" Foreground="#EF4444" FontWeight="Bold"/>
                            <TextBlock Text="✕" IsVisible="{Binding !IsOomActive}" Foreground="#64748B"/>
                            <TextBlock Text="🔴 Won't Fit" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="4">
            <StackPanel>
                <!-- Empty Results State -->
                <Border IsVisible="{Binding !FilteredHuggingFaceResults.Count}" Padding="30" HorizontalAlignment="Center">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="No models found matching your search criteria" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Try adjusting keywords, modality filters, or hardware fit toggles above." FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding FilteredHuggingFaceResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:HuggingFaceRepoItem">
                            <Border Classes="matte-card" Margin="0,0,0,8" Padding="14,12">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SecondaryBrush}"/>
                                        <TextBlock Text="{Binding Author, StringFormat='Author: {0}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- Ambient Compatibility Pill with Click-to-Inspect -->
                                        <Button Command="{Binding $parent[UserControl].((vm:HuggingFaceSearchViewModel)DataContext).InspectModelCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#1E293B"
                                                BorderBrush="{Binding FitBadge.BadgeColorHex}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                ToolTip.Tip="{Binding FitBadge.Tooltip}"
                                                IsVisible="{Binding FitBadge, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Cursor="Hand"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding FitBadge.BadgeText}" FontSize="11" Foreground="{Binding FitBadge.BadgeColorHex}" FontWeight="Bold"/>
                                                <TextBlock Text="⚡ Check Fit" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Border Classes="matte-pill" Padding="8,4" IsVisible="{Binding PipelineTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding PipelineTag}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Classes="matte-pill" Padding="8,4">
                                            <TextBlock Text="{Binding Downloads, StringFormat='⬇️ {0:N0}'}" FontSize="11" Foreground="{StaticResource TextMainBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Classes="matte-pill" Padding="8,4">
                                            <TextBlock Text="{Binding Likes, StringFormat='❤️ {0:N0}'}" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Modal overlay for fetching quant files -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="#AA000000" IsVisible="{Binding IsHfModalOpen}" ZIndex="50">
            <Border Classes="matte-card" Width="550" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding ModalRepoId}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SecondaryBrush}"/>
                            <TextBlock Text="{Binding ModalAuthor, StringFormat='Author: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseHfModalCommand}" Classes="matte-secondary" Padding="8,4"/>
                    </Grid>
                    <TextBlock Text="Available GGUF Quantizations" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                    <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsModalLoading}" Margin="0,2,0,4"/>
                    <ScrollViewer MaxHeight="300">
                        <ItemsControl ItemsSource="{Binding ModalHfFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:HfFileQuantItem">
                                    <Border Classes="matte-card" Margin="0,0,0,6" Padding="10,8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding Filename}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Classes="matte-pill" Padding="6,2">
                                                        <TextBlock Text="{Binding Quantization}" FontSize="10" Foreground="{StaticResource SecondaryBrush}" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Classes="matte-pill" Padding="6,2">
                                                        <TextBlock Text="{Binding FormatSize}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Command="{Binding $parent[UserControl].((vm:HuggingFaceSearchViewModel)DataContext).InspectQuantFileCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="#1E293B"
                                                    BorderBrush="{Binding FitBadge.BadgeColorHex}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    ToolTip.Tip="{Binding FitBadge.Tooltip}"
                                                    IsVisible="{Binding FitBadge, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding FitBadge.BadgeText}" FontSize="11" Foreground="{Binding FitBadge.BadgeColorHex}" FontWeight="Bold"/>
                                                    <TextBlock Text="⚡ Check Fit" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
