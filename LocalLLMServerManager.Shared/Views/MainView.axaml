<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             xmlns:controls="using:LocalLLMServerManager.Shared.Views.Controls"
             xmlns:services="using:LocalLLMServerManager.Shared.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
             x:Class="LocalLLMServerManager.Shared.Views.MainView"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LocalLLMServerManager.Shared/Styles/DesignTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto" Background="{StaticResource BgDarkBrush}">
        <!-- Top Telemetry Header -->
        <controls:TelemetryHeaderControl Grid.Row="0" DataContext="{Binding Telemetry}"/>

        <!-- Main Content Area: Native Avalonia XAML Tabs with Standalone Companion Actions -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" Margin="16,0,16,0">
            <TabControl.Tag>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Rectangle Width="1" Height="20" Fill="{StaticResource GlassBorderBrush}" Margin="2,0,4,0" VerticalAlignment="Center"/>
                    <Button x:Name="NavDocumentationBtn"
                            Command="{Binding ToggleDocumentationDrawerCommand}"
                            Classes="nav-tab-btn"
                            ToolTip.Tip="Open Documentation Drawer (Left Flank)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconDocumentation}" Width="14" Height="14" Foreground="{Binding $parent[Button].Foreground}"/>
                            <TextBlock Text="Documentation" VerticalAlignment="Center"/>
                            <TextBlock Text="📖" FontSize="12" Width="18" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavAiAssistBtn"
                            Command="{Binding ToggleAiAssistDrawerCommand}"
                            Classes="nav-tab-btn"
                            ToolTip.Tip="Open AI Assist Drawer (Right Flank)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconAiAssist}" Width="14" Height="14" Foreground="{Binding $parent[Button].Foreground}"/>
                            <TextBlock Text="AI Assist" VerticalAlignment="Center"/>
                            <TextBlock Text="🤖" FontSize="12" Width="18" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </TabControl.Tag>

            <!-- TAB 1: Models (Downloaded, Hugging Face Hub, CivitAI Hub) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconModels}" Width="14" Height="14" Foreground="{Binding $parent[TabItem].Foreground}"/>
                        <TextBlock Text="Models" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <controls:ModelsTabControl DataContext="{Binding}"/>
            </TabItem>

            <!-- TAB 2: Workflows (Image, Text, Video, 3D Mesh, Audio) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconWorkflows}" Width="14" Height="14" Foreground="{Binding $parent[TabItem].Foreground}"/>
                        <TextBlock Text="Workflows" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <controls:EngineStudioTabControl DataContext="{Binding}"/>
            </TabItem>

            <!-- TAB 3: Can I Run It Hardware Fit Calculator -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconCanIRunIt}" Width="14" Height="14" Foreground="{Binding $parent[TabItem].Foreground}"/>
                        <TextBlock Text="Can I Run It" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <controls:CanIRunItView DataContext="{Binding HardwareFit}"/>
            </TabItem>

            <!-- TAB 4: Remote Access & Settings -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" Foreground="{Binding $parent[TabItem].Foreground}"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <controls:SettingsTabControl DataContext="{Binding Settings}"/>
            </TabItem>
        </TabControl>

        <!-- Dimmer Backdrop for Slide-Out Drawers -->
        <Border Grid.Row="1" Background="#66000000" IsVisible="{Binding IsAnyDrawerOpen}" PointerPressed="OnBackdropPointerPressed" ZIndex="90"/>

        <!-- Left Slide-Out Drawer for Documentation -->
        <Border Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="480"
                Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="0,0,1,0" BoxShadow="4 0 24 0 #90000000"
                IsVisible="{Binding Documentation.IsDrawerOpen}" ZIndex="92">
            <Grid RowDefinitions="Auto, *">
                <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="📖" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Documentation &amp; Guides" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Content="↗️ Pop Out" Command="{Binding Documentation.PopOutNativeWindowCommand}" Classes="matte-secondary" FontSize="11" Padding="8,4" ToolTip.Tip="Pop out into native window"/>
                            <Button Content="✕" Command="{Binding CloseDrawersCommand}" Classes="matte-secondary" FontSize="11" Padding="8,4" ToolTip.Tip="Close Drawer"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <controls:DocumentationTabControl Grid.Row="1" DataContext="{Binding Documentation}"/>
            </Grid>
        </Border>

        <!-- Right Slide-Out Drawer for AI Assistant -->
        <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="460"
                Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1,0,0,0" BoxShadow="-4 0 24 0 #90000000"
                IsVisible="{Binding Assistant.IsDrawerOpen}" ZIndex="92">
            <Grid RowDefinitions="Auto, *">
                <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="🤖" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="AI Assistant" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Content="↗️ Pop Out" Command="{Binding Assistant.RequestPopOutCommand}" Classes="matte-secondary" FontSize="11" Padding="8,4" ToolTip.Tip="Pop out into native window"/>
                            <Button Content="✕" Command="{Binding CloseDrawersCommand}" Classes="matte-secondary" FontSize="11" Padding="8,4" ToolTip.Tip="Close Drawer"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <controls:AiAssistantTabControl Grid.Row="1" DataContext="{Binding Assistant}" Margin="8"/>
            </Grid>
        </Border>

        <!-- Floating Toast Notifications Overlay -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,20,24,0" IsHitTestVisible="False" ZIndex="95">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="services:ToastItem">
                    <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="6" BorderBrush="{Binding BadgeColor}" BorderThickness="1" Padding="12,8" Margin="0,0,0,8" Width="300">
                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextMainBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Service Confirmation Modal Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#A0000000" IsVisible="{Binding IsServiceConfirmModalOpen}" ZIndex="100">
            <Border Classes="matte-card" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Confirm Engine Action" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Text="{Binding ServiceConfirmMessage}" FontSize="14" Foreground="{StaticResource TextMainBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelServiceConfirmCommand}" Classes="matte-secondary" Padding="16,8"/>
                        <Button Content="Confirm" Command="{Binding ExecuteServiceConfirmCommand}" Classes="matte-primary" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10,16,10" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="{Binding AppVersionText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="System Tray Enabled 🟢" FontSize="12" Foreground="{StaticResource OnlineBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
