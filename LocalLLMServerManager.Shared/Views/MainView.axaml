<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
             xmlns:controls="using:LocalLLMServerManager.Shared.Views.Controls"
             xmlns:services="using:LocalLLMServerManager.Shared.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
             x:Class="LocalLLMServerManager.Shared.Views.MainView"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LocalLLMServerManager.Shared/Styles/DesignTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto" Background="{StaticResource BgDarkBrush}">
        <!-- Top Telemetry Ribbon (Visible on Web; embedded in custom TitleBar on Desktop) -->
        <Panel Grid.Row="0" IsVisible="{Binding !IsDesktopHost}">
            <controls:TelemetryRibbonControl DataContext="{Binding Telemetry}"/>
        </Panel>

        <!-- Main Content Area: Activity Rail + Dynamic Dual-Stage Canvas + Docked Copilot Sidebar -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto">
            <controls:ActivityRailControl Grid.Column="0" DataContext="{Binding NavigationRail}" VerticalAlignment="Stretch"/>
            <controls:DynamicStageContainerControl Grid.Column="1" DataContext="{Binding}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

            <!-- Docked Right Copilot & Knowledge Sidebar (Tabs: Assistant & Docs) -->
            <Border x:Name="DocumentationDrawer" Grid.Column="2" Width="440"
                    Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1,0,0,0" BoxShadow="-4 0 24 0 #90000000"
                    IsVisible="{Binding IsCopilotSidebarOpen}" ZIndex="92">
                <Grid RowDefinitions="Auto, *">
                    <!-- Sidebar Header: Tab Switcher & Quick Actions -->
                    <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                <Button Content="🤖 Copilot"
                                        Command="{Binding SelectCopilotTabCommand}"
                                        CommandParameter="Assistant"
                                        Classes="matte-secondary"
                                        Classes.active="{Binding IsAssistantTabActive}"
                                        FontSize="11" FontWeight="SemiBold" Padding="8,4"/>
                                <Button Content="📖 Knowledge"
                                        Command="{Binding SelectCopilotTabCommand}"
                                        CommandParameter="Docs"
                                        Classes="matte-secondary"
                                        Classes.active="{Binding IsDocsTabActive}"
                                        FontSize="11" FontWeight="SemiBold" Padding="8,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <Button Command="{Binding Assistant.RequestPopOutCommand}"
                                        IsVisible="{Binding IsAssistantTabActive}"
                                        Classes="matte-secondary" FontSize="11" Padding="6,4" ToolTip.Tip="Pop out Assistant into native window">
                                    <PathIcon Data="{StaticResource IconExternal}" Width="11" Height="11" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                                </Button>
                                <Button Command="{Binding Documentation.PopOutNativeWindowCommand}"
                                        IsVisible="{Binding IsDocsTabActive}"
                                        Classes="matte-secondary" FontSize="11" Padding="6,4" ToolTip.Tip="Pop out Documentation into native window">
                                    <PathIcon Data="{StaticResource IconExternal}" Width="11" Height="11" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                                </Button>
                                <Button Content="✕" Command="{Binding CloseDrawersCommand}" Classes="matte-secondary" FontSize="11" Padding="8,4" ToolTip.Tip="Close Sidebar"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Sidebar Content Host -->
                    <Panel Grid.Row="1">
                        <controls:AiAssistantTabControl DataContext="{Binding Assistant}" Margin="8"
                                                        IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsAssistantTabActive}"/>
                        <controls:DocumentationTabControl DataContext="{Binding Documentation}"
                                                          IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsDocsTabActive}"/>
                    </Panel>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Slide-Out Drawer for Model Pull Progress -->
        <Border x:Name="PullProgressDrawer" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="480"
                Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1,0,0,0" BoxShadow="-4 0 24 0 #90000000"
                IsVisible="{Binding Ollama.IsPullDrawerOpen}" ZIndex="93">
            <Grid RowDefinitions="Auto, *">
                <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconModels}" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Ollama Model Pull" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Content="✕" Command="{Binding ClosePullDrawerCommand}" Classes="matte-secondary" FontSize="11" Padding="8,4" ToolTip.Tip="Close Drawer"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" RowDefinitions="Auto, Auto, Auto, *" Margin="16" DataContext="{Binding Ollama}">
                    <!-- Model Name -->
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                        <TextBlock Text="PULLING MODEL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="6" Padding="10,8" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding PullModelName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- Progress Bar & Status -->
                    <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="{Binding PullProgressBytesText}" FontSize="12" Foreground="{StaticResource TextMainBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding PullProgressPercent, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding PullProgressPercent}" Height="8" CornerRadius="4" Foreground="{StaticResource AccentBrush}" Background="{StaticResource BgSurfaceBrush}"/>
                    </StackPanel>

                    <!-- Status Log Header -->
                    <TextBlock Grid.Row="2" Text="PULL LOG OUTPUT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>

                    <!-- Status Log Terminal -->
                    <Border Grid.Row="3" Background="#0C0E14" CornerRadius="6" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Padding="10">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <SelectableTextBlock Text="{Binding PullStatusLog}" FontFamily="Consolas,Menlo,monospace" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Floating Toast Notifications Overlay -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,20,24,0" IsHitTestVisible="False" ZIndex="95">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="services:ToastItem">
                    <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="6" BorderBrush="{Binding BadgeColor}" BorderThickness="1" Padding="12,8" Margin="0,0,0,8" Width="300">
                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextMainBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Service Confirmation Modal Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#A0000000" IsVisible="{Binding IsServiceConfirmModalOpen}" ZIndex="100">
            <Border Classes="matte-card" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Confirm Engine Action" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Text="{Binding ServiceConfirmMessage}" FontSize="14" Foreground="{StaticResource TextMainBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelServiceConfirmCommand}" Classes="matte-secondary" Padding="16,8"/>
                        <Button Content="Confirm" Command="{Binding ExecuteServiceConfirmCommand}" Classes="matte-primary" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10,16,10" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="{Binding AppVersionText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource OnlineBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="System Tray Enabled" FontSize="12" Foreground="{StaticResource OnlineBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
