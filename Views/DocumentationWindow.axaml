<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LocalLLMServerManager.Shared.Views.Controls"
        xmlns:vm="using:LocalLLMServerManager.Shared.ViewModels"
        x:Class="LocalLLMServerManager.Views.DocumentationWindow"
        x:DataType="vm:DocumentationViewModel"
        Icon="avares://LocalLLMServerManager/Assets/app-icon.ico"
        Title="📖 User Guides &amp; Step-by-Step Procedures"
        Width="880" Height="680"
        MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        Background="{StaticResource BgDarkBrush}">

    <Grid RowDefinitions="Auto, *">
        <!-- Window Header / Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1" Height="40"
                PointerPressed="OnTitleBarPointerPressed" DoubleTapped="OnTitleBarDoubleTapped">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="14,0">
                    <TextBlock Text="📖" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="User Guides &amp; Step-by-Step Procedures" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                    <Border Classes="matte-pill" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="Pop-Out Window" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="PinButton" Click="OnPinClicked" Classes="matte-pill" Padding="8,4" Margin="0,0,8,0" ToolTip.Tip="Toggle Always-on-Top">
                        <TextBlock x:Name="PinText" Text="📌 Pin to Top" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                    <Button Click="OnMinimizeClicked" Classes="window-control" Content="🗕" Width="38" Height="28"/>
                    <Button Click="OnMaximizeClicked" Classes="window-control" Content="🗖" Width="38" Height="28" x:Name="MaximizeButton"/>
                    <Button Click="OnCloseClicked" Classes="window-control window-close" Content="✕" Width="38" Height="28"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- In-App Documentation Content -->
        <controls:DocumentationTabControl Grid.Row="1" Margin="12,0,12,12"/>
    </Grid>
</Window>
